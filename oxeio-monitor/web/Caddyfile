# ⭐ ড্যাশবোর্ড ও API **একই origin**-এ — এটাই এই ফাইলের পুরো কারণ।
#
# ⚠️ ব্রাউজারের কাছে `/api/v1/...` একটা আপেক্ষিক পথ (`web/src/api/client.ts`),
#    আর সেশন cookie-তে `SameSite=Strict`। দুটো আলাদা origin হলে (যেমন
#    ড্যাশবোর্ড :8080, API :3000) লগইন সফল দেখাত কিন্তু পরের রিকোয়েস্টেই
#    ৪০১ — ঠিক যে ফাঁদে ডেভ মোডে একবার পড়া হয়েছিল, আর যেটার জন্য Vite-এ
#    proxy বসাতে হয়েছিল ([09 § ৩.৫](../../docs/09-Build-Log.md))।
#
# ⭐ এতে CORS-এর প্রশ্নই ওঠে না। `CORS_ORIGIN` তখন শুধু অন্য কোনো
#    ক্লায়েন্টের জন্য থাকে, ড্যাশবোর্ডের জন্য নয়।

# ⭐⭐ সাইটের ঠিকানাটা **পরিবেশ-চলক থেকে** — ফাইল বদলাতে হয় না।
#
#   কিছু না দিলে `:8080` — অফিসের LAN ও ডেভের আচরণ আগের মতোই।
#   `CADDY_SITE=monitor.oxeio.com` দিলে Caddy নিজেই ৮০ ও ৪৪৩ ধরে, আর
#   **Let's Encrypt থেকে সার্ট নিয়ে নবায়নও করে** — certbot লাগে না।
#
# ⚠️ ডোমেইন দিলে DNS আগে বসাতে হবে (A রেকর্ড → VPS-এর IP)। না বসালে
#   Let's Encrypt যাচাই করতে পারে না, আর Caddy বারবার চেষ্টা করে ব্যর্থ হয়।
{$CADDY_SITE::8080} {
	root * /srv
	encode gzip

	# ── API ───────────────────────────────────────────────────────────────
	# ⚠️ `api` নামটা docker compose-এর সার্ভিসের নাম — একই নেটওয়ার্কের
	#    ভেতরে DNS হিসেবে কাজ করে। ট্রাফিক হোস্টের বাইরে যায় না।
	handle /api/* {
		reverse_proxy api:3000 {
			# ⚠️ API-তে TLS চালু করলে (deploy/README § ৬) এই ব্লকটা খুলুন —
			#    নইলে Caddy প্লেইন HTTP পাঠাবে আর প্রতিটা রিকোয়েস্ট মরবে।
			#    সার্টটা self-signed, তাই যাচাই বাদ; সংযোগটা হোস্টের ভেতরেই।
			# transport http {
			# 	tls
			# 	tls_insecure_skip_verify
			# }
		}
	}

	# ── SPA ───────────────────────────────────────────────────────────────
	# ⚠️ try_files বাধ্যতামূলক: রুটিং ক্লায়েন্টে (react-router), তাই
	#    `/monthly` বা `/staff/7` সরাসরি খুললে ডিস্কে ওই ফাইল নেই।
	#    এটা না থাকলে refresh চাপলেই ৪০৪ — আর সেটা ধরা পড়ত রোলআউটের দিনে।
	handle {
		try_files {path} /index.html
		file_server
	}

	# ⚠️ ছবি ও রিপোর্ট বড় হতে পারে; ডিফল্ট সীমা আটকে দিত।
	request_body {
		max_size 25MB
	}

	header {
		# ক্যাশ: index.html কখনো নয় (নইলে আপডেটের পরেও পুরোনো অ্যাপ চলত),
		# hash-করা asset চিরকাল।
		?Cache-Control "no-cache"
		-Server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# ── PWA ───────────────────────────────────────────────────────────────
	# ⭐⭐ সার্ভিস ওয়ার্কারটা **কখনো ক্যাশ হবে না** — এটা এই ফাইলের সবচেয়ে
	#    জরুরি লাইন, আর ভুল হলে সবচেয়ে দেরিতে ধরা পড়ে।
	#
	# ⚠️ ব্রাউজার নতুন সংস্করণ আছে কি না জানে **কেবল `/sw.js` আবার নামিয়ে**।
	#    ফাইলটা ক্যাশ হয়ে গেলে সে পুরোনো কপি পড়ত, দেখত "একই তো", আর
	#    আপডেট **কোনোদিন** পৌঁছাত না — ডিপ্লয় সফল দেখাত, অথচ ফোনে মাসের
	#    পর মাস পুরোনো অ্যাপ চলত। ⚠️ এই ফাঁদ থেকে বেরোনোর একমাত্র উপায়
	#    ব্যবহারকারীর ফোনে হাতে সাইট-ডেটা মোছা।
	#
	# ⭐ উপরের `?Cache-Control "no-cache"` এমনিতেই এটা দিত (`?` = "কেউ না
	#    দিলে তবেই")। তবু আলাদা করে লেখা: `no-store` যোগ হয়, আর পরের জন
	#    ডিফল্টটা বদলালে এই নিয়মটা টিকে থাকে।
	# ⚠️ `/assets/*`-এর immutable নিয়মটা `/sw.js`-এ লাগে না — ওয়ার্কার
	#    ইচ্ছাকৃতভাবে সাইটের **মূলে** বসে (`assets/`-এ থাকলে তার scope
	#    হতো `/assets/`, আর নেভিগেশন কখনো ধরত না)।
	@sw path /sw.js
	header @sw Cache-Control "no-cache, no-store, must-revalidate"

	# ⚠️ manifest ও আইকনগুলোও ডিফল্ট `no-cache`-এই থাকে (`?` নিয়মটা)। এরা
	#    hash পায় না — নাম বদলায় না, শুধু ভেতরটা বদলায়। immutable করলে
	#    লোগো বদলানোর পরেও পুরোনো আইকন বসে থাকত, আর হোমস্ক্রিনে ওটাই।
	#    ফাইলগুলো ছোট, revalidate-এ ৩০৪ ফেরে — খরচ প্রায় শূন্য।

	# ⚠️⚠️ `.webmanifest`-এর MIME **হাতে** বসাতে হয়। Caddy টাইপ নেয় Go-র
	#    `mime.TypeByExtension` থেকে, আর Go-র builtin তালিকায় ওই এক্সটেনশন
	#    নেই; `caddy:2-alpine`-এ `/etc/mime.types`-ও নেই। ফলে ফাইলটা sniff
	#    হয়ে `text/plain` যেত। Chrome আজ MIME যাচাই করে না বলে তাতেও
	#    ইনস্টল হয়, কিন্তু সেটা ভরসা করার মতো জিনিস নয় — এক লাইনে নিশ্চিত।
	#    ডিপ্লয়ের পর: `curl -I https://hub.oxeio.com/manifest.webmanifest`
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"
}
