{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // ⚠️ `test` এখানে, আলাদা কোনো tsconfig-এ নয় — টেস্ট ফাইল typecheck-এর
  //    বাইরে থাকলে ভাঙা import বা বদলে যাওয়া সিগনেচার শুধু `vitest`
  //    চালালেই ধরা পড়ত, `npm run typecheck`-এ নয়।
  "include": ["src", "test"]
}
