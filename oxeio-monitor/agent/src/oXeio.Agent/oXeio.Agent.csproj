<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = কনসোল উইন্ডো নেই। tray আইকনই এজেন্টের একমাত্র মুখ।
         Exe দিলে প্রতিবার লগঅনে ১৫টা PC-তে একটা কালো কনসোল খুলে বসে থাকত,
         আর স্টাফ সেটা বন্ধ করলেই এজেন্ট মরত।
         diagnose মোডে Program.cs নিজে কনসোল জুড়ে নেয়। -->
    <OutputType>WinExe</OutputType>
    <!-- 10.0.17763 = Windows 10 1809, আমাদের সর্বনিম্ন লক্ষ্য।
         খালি `net8.0-windows` দিলে platform version 7.0 ধরে নেয়, আর তখন
         SupportedOSPlatformVersion বসানো যায় না। -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- NativeWindow-এর জন্য — হাতে CreateWindowExW করলে delegate-এর আয়ু নিয়ে
         CallbackOnCollectedDelegate শ্রেণির বাগের ঝুঁকি থাকে -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- ⚠️ WPF নিজে ব্যবহার করা হয় **না**। এটা শুধু
         System.Windows.Automation-এর জন্য (D03 — ব্রাউজারের address bar,
         ADR-013)। UIAutomationClient WPF-এর অংশ হিসেবেই আসে।
         আকারে খরচ নেই: self-contained publish-এ WindowsDesktop রানটাইমের
         WPF অ্যাসেম্বলিগুলো এমনিতেও যায়, শুধু রেফারেন্স করা হতো না। -->
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      ⭐⭐ **ব্র্যান্ড আইকন** — `web/public/favicon.svg`-এর সেই লাল টাইল ও
           সাদা X, অর্থাৎ ওয়েব আর এজেন্ট একই মুখ দেখায়।

      ⚠️ এটা exe-র ভেতরে বসে, তাই Explorer, টাস্কবার, alt-tab আর
         "Add or remove programs" — সবখানেই এটাই দেখা যায়। আগে কিছুই বসানো
         ছিল না, তাই Windows-এর ডিফল্ট ফাঁকা আইকনটা দেখাত।

      ⚠️⚠️ ফাইলটা `installer/make-icon.py` **তৈরি করে**, হাতে আঁকা নয়।
         TrayIconPainter-এর ডকে লেখা আছে রিপোতে `.ico` বাইনারি না রাখার
         কারণ — ডিফ পড়া যায় না। ⭐ এখানে ব্যতিক্রমটা টিকছে কারণ **উৎসটা
         রিপোতেই আছে**: বদলাতে হলে ওই স্ক্রিপ্টটা বদলাবেন, আর ডিফে সেটাই
         পড়া যাবে। বাইনারিটা তার ফল মাত্র।
    -->
    <ApplicationIcon>..\..\installer\oxeio.ico</ApplicationIcon>

    <RootNamespace>oXeio.Agent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      WFAC010: WinForms analyzer চায় DPI সেটিং ম্যানিফেস্ট থেকে সরিয়ে
      Application.SetHighDpiMode()-এ নিতে। এখানে ইচ্ছাকৃতভাবে সেটা মানা হচ্ছে না।

      কারণ: ওই API কাজ করে শুধু প্রসেসে **প্রথম HWND তৈরি হওয়ার আগে**। tray আইকন,
      NativeWindow, বা যেকোনো লাইব্রেরির লুকানো উইন্ডো Main-এর শরীর চলার আগেই একটা
      HWND বানিয়ে ফেলতে পারে — তারপর কলটা নীরবে ব্যর্থ হয়, কোনো ব্যতিক্রম ছাড়াই,
      আর প্রসেস DPI-unaware থেকে যায়। তখন ১৫০% স্কেলের 4K মনিটরের স্ক্রিনশট ঝাপসা
      আসে আর ছোট হরফ পড়াই যায় না — অথচ স্ক্রিনশটের উদ্দেশ্যই ওই লেখা দেখা।

      ম্যানিফেস্ট প্রসেস শুরুর আগেই প্রযোজ্য হয়, তাই ওটাই একমাত্র নির্ভরযোগ্য পথ।
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ⚠️⚠️ `ApplicationIcon` **যথেষ্ট নয়** — ওটা exe-র শেল-আইকন ঠিক করে,
         কিন্তু WinForms একটা Form-এর টাস্কবার আইকন নেয় `Form.Icon` থেকে,
         আর সেটা না দিলে **নিজের ডিফল্ট আইকনটাই** বসায়। ঠিক এই কারণেই
         টাস্কবারে সাদা-নীল ফাঁকা জানালাটা দেখা যেত।

      ⭐ তাই একই ফাইল রিসোর্স হিসেবেও ঢোকে, আর `OwnerDrawnForm` সেটা পড়ে।
         ২৮ KB — ৬২ MB-র MSI-তে ধর্তব্য নয়।
    -->
    <EmbeddedResource Include="..\..\installer\oxeio.ico" LogicalName="oXeio.Agent.brand.ico" />
  </ItemGroup>


  <ItemGroup>
    <!-- ⚠️ UseWPF চালু করলে SDK-র implicit using-এর সেটটাই বদলে যায় —
         System.IO আর System.Net.Http **বাদ পড়ে**, আর তখন HttpClient বা
         FileStream হঠাৎ "খুঁজে পাওয়া যাচ্ছে না" বলে বিল্ড ভাঙে। ফাইলগুলোতে
         কিছুই বদলায়নি, শুধু csproj-এ একটা লাইন যোগ হয়েছিল — কারণ খুঁজে
         পেতে সময় লাগে। তাই স্পষ্ট করে ফিরিয়ে আনা হলো। -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\oXeio.Core\oXeio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- এখানকার সব টাইপ `internal` — টেস্ট প্রজেক্টকে দেখতে দেওয়া ছাড়া
         Win32-নির্ভর মডিউলগুলোর কোনো টেস্ট লেখা যেত না। শুধু টেস্ট
         লেখার জন্য টাইপগুলো `public` করা হয়নি; ওতে API surface বেড়ে যেত। -->
    <InternalsVisibleTo Include="oXeio.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />

    <!-- অফলাইন কিউ। ৮.x ব্যান্ডেই রাখা — ৯/১০.x .NET 9+ চায়, আর এজেন্টের
         TFM net8.0-windows। EF Core টানা হয় না, শুধু ADO.NET প্রোভাইডার। -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
  </ItemGroup>

</Project>
