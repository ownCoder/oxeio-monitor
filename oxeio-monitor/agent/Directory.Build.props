<Project>

  <!--
    ⭐⭐ এজেন্টের ভার্সনের **একমাত্র উৎস**।

    ⚠️ আগে ভার্সন ছিল তিন জায়গায়, আর তিনটের মধ্যে কোনো যোগ ছিল না:
      · Program.cs-এ  `const string Version = "0.1.0"`  ← সার্ভারকে যা বলা হতো
      · installer/build.ps1-এ  `$Version = '0.1.0'`      ← MSI-তে যা বসত
      · কোথাও `<Version>` না থাকায় assembly হতো 1.0.0.0

    ⚠️⚠️ ফলটা নীরব কিন্তু গুরুতর: MSI ০.২.০ বানিয়ে ১৫টা PC-তে বিলি করলেও
    এজেন্ট heartbeat-এ নিজেকে **০.১.০** বলত। সার্ভার সেই স্টেল মান দেখে
    ঠিক করত আপডেট অফার করবে কি না (G59), তাই আপডেট হয়ে যাওয়া মেশিনকেও
    **একই আপডেট বারবার** অফার করা হতো — H04-এর ধাপে ধাপে রোলআউট কোনোদিন
    শেষই হতো না।

    এখন এখানে একবার বদলালেই তিন জায়গায় পৌঁছায়:
      · assembly-র InformationalVersion  (Program.cs রানটাইমে পড়ে)
      · MSI-র ProductVersion             (build.ps1 এখান থেকেই পড়ে)
  -->
  <PropertyGroup>
    <!--
      ⚠️ ০.১.০ → ০.২.০ (১২ আগস্ট ২০২৬)। এজেন্টে চারটে সত্যিকারের বদল
      হয়েছে: H06 (revoke করলে ক্যাপচার থামে) · A05 (কিউয়ের ডিস্ক-বাজেট
      সত্যিই প্রয়োগ হয়) · H08 (`logs\agent.log`) · কনফিগ লুপ।

      ⚠️⚠️ সংখ্যাটা না বাড়ালে **আপডেট বিলি করা যেত না**: `rollout.ts`
      SemVer তুলনা করে, তাই ০.১.০ চালানো PC-কে ০.১.০ অফার করা হতো না
      (G59)। MSI নিজে `AllowSameVersionUpgrades="yes"` দিয়ে বসত, কিন্তু
      সেটা হাতে গিয়ে বসানো — H04-এর পুরো ব্যবস্থাটাই অচল থাকত।
    -->
    <!--
      ⚠️⚠️ ০.২.০ → ০.৩.০ (১২ আগস্ট, দ্বিতীয় দফা)। কোডে নতুন কিছু আছে
      বটে (সাইন-ইন জানালা · enroll-login · সার্ট পিনিং), কিন্তু বাড়ানোর
      **আসল কারণ আলাদা**: ০.২.০ নামে **তিনটে আলাদা বাইনারি** বেরিয়ে গেছে —
      ০৯:৪৮ (সাইন-ইন জানালা ছাড়া), ১৫:৫৩ (জানালা সহ), ১৬:৪৩ (পিনিং সহ)।

      ⚠️ ফাইলের নাম এক, ভার্সনও এক — কোনটা কোনটা সেটা বলার কোনো উপায়
      ছিল না, আর মালিক পুরোনোটা চালিয়ে ভাবছিলেন ফিচারটা আসেনি। সংখ্যাটা
      বাড়ানোই একমাত্র উপায় যাতে দুটো বিল্ড আলাদা করে চেনা যায়।

      ⭐ শিক্ষা: **বাইনারি হাতে বিলি করার আগেই ভার্সন বাড়াও** — কোডে
      বদল আসার পরে নয়।
    -->
    <!--
      ০.৩.০ → ০.৩.১ (১২ আগস্ট সন্ধ্যা)। ০.৩.০ মালিককে দিয়ে দেওয়ার **পরে**
      একটা বাগ ধরা পড়েছে (লগে UTF-8 BOM নেই, তাই Get-Content ভাঙা হরফ
      দেখায়) — তাই নতুন নম্বর।

      ⭐ এটাই উপরের নিয়মটা মেনে চলার প্রথম উদাহরণ: বাইনারি বেরিয়ে গেলে
      কোড বদলানোর সাথে সাথে নম্বরও বাড়ে।
    -->
    <!--
      ⭐⭐ ০.৩.১ → ০.৩.২ (১২ আগস্ট রাত)। এবারের বদলটা এজেন্টে নয়,
      **ইনস্টলারে** — কিন্তু নম্বরটা এজেন্টের সাথেই বাঁধা, তাই একসাথেই বাড়ে।

      ⚠️ মালিক ০.৩.১ বসিয়ে জানালেন "install korar pore run hoyna"। বাইনারি
      নিখুঁত ছিল — হাতে চালালে সাইন-ইন জানালা আসত। ইনস্টলার লগঅন-টাস্কটা
      বানাত, কিন্তু **চালু করত না**, আর টাস্কের ট্রিগার লগঅন। ফলে ইনস্টলার
      "সফল" বলে বেরিয়ে যেত আর পরের রিবুট পর্যন্ত কিছুই হতো না।
    -->
    <Version>0.3.2</Version>

    <!--
      ⚠️ AssemblyVersion-এ শুধু তিন অঙ্ক রাখা হয় (SemVer-এর pre-release
      অংশ ছাড়া) — Windows-এর ভার্সন রিসোর্স `1.2.3-beta` মানে না, আর
      বসাতে গেলে বিল্ডই ভাঙে।
    -->
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>

    <Company>oXeio</Company>
    <Product>oXeio Monitor</Product>
  </PropertyGroup>

</Project>
