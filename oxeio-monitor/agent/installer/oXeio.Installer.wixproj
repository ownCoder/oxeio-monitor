<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>oXeioAgent</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>

    <!-- এজেন্টের ভার্সনের সাথে মিলিয়ে রাখতে হবে (Program.cs · Version) -->
    <AgentVersion>0.1.0</AgentVersion>

    <PublishDir>$(MSBuildThisFileDirectory)obj\stage</PublishDir>
    <DefineConstants>AgentVersion=$(AgentVersion);PublishDir=$(PublishDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <!--
    ⚠️ দুটোই **self-contained** — অফিসের ১৫টা PC-তে .NET রানটাইম আলাদা করে
    বসানোর ঝামেলা নেই, আর রানটাইম আপডেট হলে এজেন্ট ভাঙার ঝুঁকিও নেই
    (ADR-002)। দাম: প্যাকেজের আকার বড়।

    ⚠️ watchdog **আগে** publish হয়, এজেন্ট পরে। দুটোরই আউটপুট একই
    ফোল্ডারে যায়, আর দুটোতেই oXeio.Core.dll আছে — এজেন্টেরটাই শেষে বসুক,
    কারণ ওটাই বেশি নির্ভরতা টানে।
  -->
  <Target Name="StageBinaries" BeforeTargets="BeforeBuild">
    <RemoveDir Directories="$(PublishDir)" />

    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\src\oXeio.Watchdog\oXeio.Watchdog.csproj&quot; -c Release -r win-x64 --self-contained true -p:PublishSingleFile=false -o &quot;$(PublishDir)&quot;" />

    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\src\oXeio.Agent\oXeio.Agent.csproj&quot; -c Release -r win-x64 --self-contained true -p:PublishSingleFile=false -o &quot;$(PublishDir)&quot;" />

    <!-- .pdb ডিবাগ সিম্বল — স্টাফের PC-তে পাঠানোর কিছু নেই, শুধু আকার বাড়ায় -->
    <ItemGroup>
      <StagedPdb Include="$(PublishDir)\*.pdb" />
    </ItemGroup>
    <Delete Files="@(StagedPdb)" />
  </Target>

</Project>
