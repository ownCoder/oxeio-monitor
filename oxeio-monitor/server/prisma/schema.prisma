// ─────────────────────────────────────────────────────────────────────────────
//  oXeio Monitoring — database schema  ·  ১৯টি মডেল
//
//  সত্যের উৎস : docs/07-Technical-Spec.md § ২
//  গণনার নিয়ম  : docs/07-Technical-Spec.md § ২.১ (ক–ঙ)
//
//  এই স্কিমা যে চারটি সিদ্ধান্ত টাইপ-লেভেলেই আটকে দেয়:
//    · SegmentState-এ মাত্র তিনটি মান — BREAK/MEETING/OFF_SHIFT নেই (ADR-011d)
//    · কোনো shifts / leave_requests / time_claims টেবিল নেই (ADR-011b, 011d)
//    · প্রতিটি ingest টেবিলে clientUuid — ডুপ্লিকেট ঠেকাতে (G29)
//    · workedSec (কাঁচা) ও creditedSec (টার্গেটে যায়) আলাদা (G35)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════ enums ══════════════════════════════

/// মাত্র তিনটি স্টেট। BREAK / MEETING / OFF_SHIFT ইচ্ছাকৃতভাবে নেই — ADR-011d।
enum SegmentState {
  active
  idle
  locked
}

/// ⭐⭐ **পোর্টালের ভূমিকা** — কে কোন পর্দায় ঢুকতে পারেন।
///
/// ⚠️⚠️ `staffType`-এর সাথে গুলিয়ে ফেলবেন না: ওটা **কী কাজ করেন**
/// (designer · researcher · manager), এটা **কী দেখতে পান**।
///
/// ⭐ `researcher` যোগ হয়েছে ২৫ আগস্ট ২০২৬ — মালিকের যুক্তি:
/// *"researcher and designer same kaj kore na, tai eder access o same
/// hobe na"*। এতদিন দুজনেরই রোল ছিল `employee`, আর পার্থক্যটা লুকিয়ে
/// ছিল অন্য টেবিলে — সাইডবারে তাই `when: canAddTargets` হ্যাক বসাতে
/// হয়েছিল।
///
/// ⚠️⚠️ **নতুন মান যোগ করা fail-closed নয় সব জায়গায়।** `@Roles()` ও
/// সাইডবারের `roles[]` allowlist ধরে চলে — সেখানে নিরাপদ। কিন্তু
/// হাতে-লেখা `role !== employee` শর্ত **উল্টো দিকে খোলে**; ওগুলো
/// এখন `owner || manager` ধরে লেখা (09 § ৩ঞ১০)।
enum UserRole {
  owner
  manager
  researcher
  employee
}

/**
 * ⭐ **কর্মীর কাজের ধরন** *(২১ আগস্ট ২০২৬, মালিকের চাওয়া)*।
 *
 * ⚠️⚠️ এটা `UserRole`-এর সাথে **গুলিয়ে ফেলবেন না**। `UserRole` বলে *কে কী
 * দেখতে পাবে* (পোর্টালের অনুমতি); এটা বলে *কে কী কাজ করে*। একজন মানুষ
 * `manager` ধরনের হয়েও পোর্টালে `employee` হতে পারেন, আর উল্টোটাও।
 *
 * ⚠️ `designation` ঘরটা **থেকেই যাচ্ছে** — ওটা পদবি ("Senior Graphic
 * Designer"), মুক্ত-লেখা। এটা **শ্রেণি**, আর কেবল এর উপরেই নিয়ম বসতে পারে
 * (যেমন ডিজাইনারের দৈনিক ২৫টার টার্গেট)। মুক্ত-লেখায় নিয়ম বসালে
 * "Designer" আর "graphic designer" দু-রকম হয়ে যেত।
 */
enum StaffType {
  designer
  researcher
  manager
}

/**
 * একটা ডিজাইন-টার্গেট জীবনের কোন ধাপে *(২২ আগস্ট ২০২৬)*।
 *
 * ⚠️ `skipped` আলাদা রাখা হয়েছে `done`-এর থেকে: বাদ দেওয়া টার্গেট কারো
 * কাজ নয়, তাই গোনায় আসে না — কিন্তু পুলে ফেরতও যায় না, নইলে পরদিন
 * আবার কারো হাতে পড়ত।
 */
enum DesignTargetStatus {
  pool
  assigned
  done
  skipped

  /**
   * ⭐⭐ **Amazon-এ পাতাটাই আর নেই** *(২৯ আগস্ট ২০২৬)* — মালিক বা ম্যানেজার
   * হাতে বেছে মুছেছেন।
   *
   * ⚠️⚠️ সারিটা **টেবিলে থেকে যায়**, আর সেটাই এর গোটা কারণ: `asin` UNIQUE,
   * তাই মরা ASIN-টা আর কোনোদিন পুলে ফিরতে পারে না। সত্যিকারের `DELETE`
   * ঠিক এই প্রহরীটাকেই মুছে ফেলত।
   *
   * ⚠️ `skipped` নয় — ওটা ডিজাইনারের "করতে চাই না", এটা "জিনিসটাই নেই"।
   */
  deleted
}

enum EmployeeStatus {
  active
  inactive
}

enum DeviceStatus {
  active
  revoked
}

enum Productivity {
  productive
  neutral
  unproductive
}

enum MatchType {
  process
  domain
  title_regex
}

enum DayType {
  worked
  no_activity
  holiday
}

/// day_rollover = মধ্যরাতে সেশন ভাগ হয়েছে (§ ২.১-ক)। shift_end নেই — শিফটই নেই।
enum SessionEndReason {
  logoff
  shutdown
  timeout
  day_rollover
}

enum AdjustmentCause {
  agent_down
  server_down
  agent_crash
  pc_replaced
  data_loss
  other
}

enum AlertSeverity {
  info
  warning
  critical
}

enum RolloutStage {
  canary
  partial
  all
  halted
}

// ══════════════════════════ reference / config ══════════════════════════

/// ⚠️ shifts টেবিলের বদলে এটি। কোনো শিফট উইন্ডো, লাঞ্চ উইন্ডো বা আসার নির্দিষ্ট সময় নেই।
model WorkPolicy {
  id                 Int     @id @default(autoincrement())
  name               String
  /// ⭐ একমাত্র টার্গেট
  monthlyTargetHours Decimal @default(208) @map("monthly_target_hours") @db.Decimal(6, 2)
  /// fallback মাত্র — আসল হিসাব ক্যালেন্ডার থেকে, § ২.১-খ
  expectedWorkdays   Int     @default(26) @map("expected_workdays")
  /// ISO দিন (শুক্র = 5)। null হলে প্রতিটি ক্যালেন্ডার দিনই কর্মদিবস।
  /// ⚠️ এটা ব্লক নয় — ছুটির দিনে কাজ করলেও ঘণ্টা পুরোপুরি গোনা হয়।
  weeklyOffDay       Int?    @map("weekly_off_day") @db.SmallInt
  /// 'HH:MM' — ক্যাপচার উইন্ডো। null হলে ২৪ ঘণ্টা ছবি ওঠে।
  screenshotFrom     String? @map("screenshot_from") @db.VarChar(5)
  screenshotTo       String? @map("screenshot_to") @db.VarChar(5)
  /**
   * ⭐⭐ **অফিস কখন খোলা** *(২২ আগস্ট ২০২৬)* — মালিকের চাওয়া ৯টা–৬টা।
   *
   * ⚠️⚠️ এটা `screenshotFrom/To`-র **বিকল্প নয়, আলাদা প্রশ্ন**। ক্যাপচার
   * উইন্ডো ৭টা–১১টা (কেউ আগে এলে বা দেরি করে থাকলেও ছবি উঠুক), কিন্তু
   * **অফিস** ৯টা–৬টা। দুটোকে এক ধরে নিলে সন্ধ্যা ৭টায় PC বন্ধ থাকা
   * "সমস্যা" হিসেবে গোনা হতো।
   *
   * ⭐ এখন পর্যন্ত এর একমাত্র ব্যবহার: `agent_down` অ্যালার্ট কখন **তুলব
   * না** (G01)। অফিস বন্ধ থাকলে PC নিভে থাকাটাই স্বাভাবিক, খবর নয়।
   * ⚠️ এটা ঘণ্টা গোনায় কোনো প্রভাব ফেলে না — কেউ রাত ৯টায় কাজ করলে
   * তাঁর ঘণ্টা আগের মতোই পুরোপুরি গোনা হয়।
   *
   * null হলে **সারাদিনই খোলা** ধরা হয় — অর্থাৎ আগের আচরণ, যাতে মান না
   * বসানো থাকলে অ্যালার্ট নীরবে বন্ধ হয়ে না যায়।
   */
  officeFrom         String? @map("office_from") @db.VarChar(5)
  officeTo           String? @map("office_to") @db.VarChar(5)
  /**
   * ⭐⭐ **ডিজাইনারের দৈনিক টার্গেট** *(২১ আগস্ট ২০২৬)* — মালিকের চাওয়া ২৫।
   *
   * ⚠️ ঘণ্টার টার্গেটের **পাশে**, বিকল্প নয়: ডিজাইনারও ২০৮ ঘণ্টা মেনে
   * চলেন, তার উপরে এই সংখ্যাটা। ⚠️⚠️ এটা কেবল `staff_type = 'designer'`
   * কর্মীদের জন্য খাটে (`hasDesignTarget()`); বাকিদের পর্দায় ঘরটাই ওঠে না,
   * কারণ "০/২৫" দেখতে অভিযোগের মতো লাগে অথচ মাপটাই তাঁদের নয়।
   * ⚠️ ০ বসালে টার্গেট **বন্ধ** — সংখ্যা গোনা চলবে, কিন্তু কেউ "পিছিয়ে" নয়।
   */
  dailyDesignTarget  Int     @default(25) @map("daily_design_target")
  idleThresholdSec   Int     @default(60) @map("idle_threshold_sec")
  slotMinutes        Int     @default(5) @map("slot_minutes")
  /// Asia/Dhaka = GMT+6 (UTC+06:00), কোনো DST নেই — তাই work_date সবসময় নির্দ্বিধায় বের হয়
  timezone           String  @default("Asia/Dhaka")
  isActive           Boolean @default(true) @map("is_active")

  employees Employee[]

  @@map("work_policies")
}

model Employee {
  id             Int            @id @default(autoincrement())
  empCode        String         @unique @map("emp_code")
  fullName       String         @map("full_name")
  email          String?        @unique
  /// পদবি — মুক্ত-লেখা, শুধু দেখানোর জন্য ("Senior Graphic Designer")
  designation    String?
  department     String?
  /**
   * ⭐ কাজের ধরন — নিয়ম **কেবল এর উপরেই** বসে ([StaffType](#StaffType))।
   *
   * ⚠️ `null` মানে "এখনো বসানো হয়নি", আর সেটা `designer`-এর সমান নয়:
   * টার্গেটের হিসাব তখন ওই কর্মীকে **ছেড়ে দেয়**, শূন্য ধরে না।
   */
  staffType      StaffType?     @map("staff_type")
  /**
   * ⭐⭐ **এই কর্মীর নিজের দৈনিক ডিজাইন-টার্গেট** *(২২ আগস্ট)* — মালিকের
   * কথায়: *"karo daily target 25 ta, kono designer er daily target 15 ta"*।
   *
   * ⚠️ `null` মানে **পলিসির সংখ্যাটাই খাটবে** (`work_policies.daily_design_target`),
   * শূন্য নয়। ⚠️⚠️ ডিফল্ট বসানো হয়নি ইচ্ছাকৃতভাবে: ডিফল্ট থাকলে "কেউ
   * কিছু বলেনি" আর "মালিক নিজে এই সংখ্যাটা বেছে দিয়েছেন" — দুটো দেখতে
   * এক হয়ে যেত, ঠিক যেমন `depositStartYearMonth`-এ।
   */
  dailyDesignTarget Int?         @map("daily_design_target")
  policyId       Int?           @map("policy_id")
  /// ⭐ মাসিক বেতন — **শুধু owner দেখতে পায়** ([ADR-023](../../docs/05-Options-Decisions.md))।
  /// ঘাটতির টাকা বের করতে লাগে: (বেতন ÷ মাসিক টার্গেট ঘণ্টা) × ঘাটতি-ঘণ্টা।
  /// ⚠️ Decimal, Float নয় — টাকা কখনো binary float-এ রাখা হয় না।
  monthlySalary  Decimal?       @map("monthly_salary") @db.Decimal(12, 2)
  /// ⭐ পুরোনো বেতনগুলো — অতীতের পে-রোল যাতে না নড়ে (SalaryPeriod-এর ডক দেখুন)
  salaryPeriods  SalaryPeriod[]
  joinedOn       DateTime?      @map("joined_on") @db.Date

  /**
   * R21 — জামানত কাটা **কোন মাস থেকে শুরু**, এই কর্মীর জন্য (`YYYY-MM`)।
   *
   * ⭐ `null` মানে "নিয়মের সাধারণ শুরুর মাসই খাটবে"
   * (`deposit_policy.start_year_month`) — তাই পুরোনো সব সারি আগের মতোই চলে।
   *
   * ⚠️ ডিফল্ট বসানো হয়নি ইচ্ছাকৃতভাবে: ডিফল্ট থাকলে "কেউ কিছু বলেনি" আর
   * "মালিক নিজে এই মাসটা বেছে দিয়েছেন" — দুটো দেখতে এক হয়ে যেত।
   */
  depositStartYearMonth String? @map("deposit_start_year_month") @db.Char(7)
  leftOn         DateTime?      @map("left_on") @db.Date
  status         EmployeeStatus @default(active)
  /// সই করা monitoring policy — রোলআউটের বাধ্যতামূলক শর্ত
  policySignedAt DateTime?      @map("policy_signed_at") @db.Timestamptz(3)
  policyDocPath  String?        @map("policy_doc_path")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  policy            WorkPolicy?        @relation(fields: [policyId], references: [id])
  devices           Device[]
  portalUsers       User[]
  workSessions      WorkSession[]
  segments          ActivitySegment[]
  screenshots       Screenshot[]
  appUsage          AppUsage[]
  events            Event[]
  dailySummaries    DailySummary[]
  designCredits     DesignCredit[]
  designTargets     DesignTarget[]
  monthlySummary    MonthlySummary[]
  timeAdjustments   TimeAdjustment[]
  enrollmentCodes   EnrollmentCode[]
  alerts            Alert[]
  leaves            Leave[]
  deposits          SecurityDeposit[]
  depositSettlement DepositSettlement?

  @@map("employees")
}

/// ড্যাশবোর্ডে লগইন করা ইউজার — owner, manager, আর স্টাফের self-view
model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         UserRole
  /// role = employee হলে কোন স্টাফ
  employeeId   Int?      @map("employee_id")
  totpSecret   String?   @map("totp_secret")
  isActive     Boolean   @default(true) @map("is_active")
  /// প্রথম লগইনে পাসওয়ার্ড বদলাতেই হবে (G33)
  mustChangePw Boolean   @default(true) @map("must_change_pw")
  pwChangedAt  DateTime? @map("pw_changed_at") @db.Timestamptz(3)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// ⭐ যেসব ডিজাইন-টার্গেট ইনি "শেষ" বলেছেন
  completedTargets DesignTarget[] @relation("designTargetCompletedBy")
  /// ⭐ বানান যাচাই করেছেন (ADR-038) — সাধারণত গবেষক
  checkedTargets   DesignTarget[] @relation("designTargetCheckedBy")
  /** ⭐ বাদ-যাওয়া যেসব ডিজাইন ইনি দেখে নিয়েছেন *(৩১ আগস্ট)* */
  reviewedTargets  DesignTarget[] @relation("designTargetReviewedBy")
  /// ⭐ ভুল ঠিক করেছেন — সাধারণত ম্যানেজার
  fixedTargets     DesignTarget[] @relation("designTargetFixedBy")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee           Employee?        @relation(fields: [employeeId], references: [id])
  auditLogs          AuditLog[]
  settingsUpdated    Setting[]
  alertsAcknowledged Alert[]
  enrollmentCodes    EnrollmentCode[]
  adjustmentsCreated TimeAdjustment[] @relation("AdjustmentCreatedBy")
  adjustmentsRevoked TimeAdjustment[] @relation("AdjustmentRevokedBy")

  @@map("users")
  /// ⭐ যে টার্গেটগুলো ইনি জমা দিয়েছেন (২২ আগস্ট)
  addedTargets DesignTarget[] @relation("addedTargets")
}

model Device {
  id              Int           @id @default(autoincrement())
  hostname        String
  windowsUsername String        @map("windows_username")
  employeeId      Int?          @map("employee_id")
  /// হার্ডওয়্যার-ভিত্তিক স্থায়ী আইডি
  /// ⚠️⚠️ **আর UNIQUE নয়** — একই PC-তে দুজন স্টাফ আলাদা Windows
  /// অ্যাকাউন্টে কাজ করলে দুটো সারি লাগে, অথচ `MachineGuid` মেশিনের,
  /// ব্যবহারকারীর নয়। ডিভাইসের পরিচয় এখন `@@unique([hostname,
  /// windowsUsername])` (নিচে) — মেশিন **ও** যিনি বসেছেন, দুটো মিলে।
  /// ⭐ মানটা রাখা আছে: H04-এর rollout bucket এটা দিয়েই গোনা হয়, আর
  /// এজেন্ট নিজের `device.dat` এর সাথে মিলিয়ে ক্লোন ধরে।
  machineGuid     String        @map("machine_guid")
  osVersion       String?       @map("os_version")
  agentVersion    String?       @map("agent_version")
  /// ⭐⭐ **কবে থেকে এই ডিভাইস ওই ভার্সনটা চালাচ্ছে** *(৫ সেপ্টেম্বর ২০২৬)*।
  ///
  /// ⚠️⚠️ H04-এর রোলআউট নিজে থেকে এগোনোর (`canary → partial → all`)
  /// একমাত্র প্রমাণ এটাই। `released_at` দিয়ে গোনা যেত না: ওটা বলে
  /// **কবে প্রকাশ হয়েছে**, আর প্রশ্নটা হলো **কোনো আসল মেশিন কতক্ষণ ধরে
  /// এটা চালিয়ে টিকে আছে**। প্রকাশের ছ-ঘণ্টা পর এগোলে canary-র পুরো
  /// মানেই থাকত না — কেউ ইনস্টল না করলেও ধাপ বাড়ত।
  ///
  /// ⚠️ `null` মানে "জানি না" — ওই ডিভাইস কোনো প্রমাণ দেয় না। পুরোনো
  /// সারিগুলো তাই খালি থাকে, আর পরের আপডেটেই ভরে যায়।
  agentVersionSince DateTime?   @map("agent_version_since") @db.Timestamptz(3)
  /// device token-এর sha256 — plaintext কখনো জমা হয় না
  tokenHash       String        @map("token_hash")
  monitors        Int           @default(1)
  status          DeviceStatus  @default(active)
  lastSeenAt      DateTime?     @map("last_seen_at") @db.Timestamptz(3)
  /// ⭐ শেষ heartbeat-এ এজেন্ট কী বলেছিল। এটা ছাড়া Live Board শেষ
  /// activity_segments সারি থেকে **অনুমান** করত, আর এজেন্ট সেগমেন্ট
  /// ব্যাচে পাঠায় বলে বোর্ডের স্ট্যাটাস কয়েক মিনিট পুরোনো দেখাত।
  lastState       SegmentState? @map("last_state")
  lastStateAt     DateTime?     @map("last_state_at") @db.Timestamptz(3)
  lastDriftSec    Int           @default(0) @map("last_drift_sec")
  maxDriftSec     Int           @default(0) @map("max_drift_sec")
  enrolledAt      DateTime      @default(now()) @map("enrolled_at") @db.Timestamptz(3)

  employee        Employee?         @relation(fields: [employeeId], references: [id])
  workSessions    WorkSession[]
  segments        ActivitySegment[]
  screenshots     Screenshot[]
  appUsage        AppUsage[]
  events          Event[]
  alerts          Alert[]
  enrollmentCodes EnrollmentCode[]
  /** ⭐ যেসব রিলিজে এই PC-টাই পাইলট *(১ সেপ্টেম্বর ২০২৬)* */
  pilotForVersions AgentVersion[] @relation("agentVersionPilot")

  @@unique([hostname, windowsUsername])
  @@map("devices")
}

/// এজেন্ট রেজিস্ট্রেশনের একবার-ব্যবহার্য কোড (G34)
model EnrollmentCode {
  id             Int       @id @default(autoincrement())
  /// কোড কখনো plaintext-এ জমা হয় না — একবারই দেখানো হয়
  codeHash       String    @unique @map("code_hash")
  employeeId     Int       @map("employee_id")
  createdById    Int       @map("created_by")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  usedByDeviceId Int?      @map("used_by_device_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee     Employee @relation(fields: [employeeId], references: [id])
  createdBy    User     @relation(fields: [createdById], references: [id])
  usedByDevice Device?  @relation(fields: [usedByDeviceId], references: [id])

  @@map("enrollment_codes")
}

// ══════════════════════════ core tracking ══════════════════════════

/// PC-তে লগইন থেকে লগআউট পর্যন্ত একটা সেশন। মধ্যরাতে ভাগ হয় (§ ২.১-ক)।
model WorkSession {
  id         BigInt            @id @default(autoincrement())
  employeeId Int               @map("employee_id")
  deviceId   Int               @map("device_id")
  /// Asia/Dhaka অনুযায়ী
  workDate   DateTime          @map("work_date") @db.Date
  startedAt  DateTime          @map("started_at") @db.Timestamptz(3)
  endedAt    DateTime?         @map("ended_at") @db.Timestamptz(3)
  endReason  SessionEndReason? @map("end_reason")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee          @relation(fields: [employeeId], references: [id])
  device   Device            @relation(fields: [deviceId], references: [id])
  segments ActivitySegment[]

  @@index([employeeId, workDate])
  @@map("work_sessions")
}

/// ⭐ মূল টাইম ট্র্যাকিং টেবিল।
/// ⚠️ কোনো সেগমেন্ট দুই workDate জুড়ে থাকতে পারবে না — মধ্যরাতে ভাগ হয় (§ ২.১-ক)।
/// ⚠️ এই টেবিল কখনো এডিট বা ডিলিট হয় না — সংশোধন যায় TimeAdjustment-এ (§ ২.১-ঙ)।
model ActivitySegment {
  id           BigInt       @id @default(autoincrement())
  sessionId    BigInt       @map("session_id")
  employeeId   Int          @map("employee_id")
  /// একই স্টাফের দুই ডিভাইসে overlap ধরার জন্য (§ ২.১-গ)
  deviceId     Int          @map("device_id")
  /// এজেন্টের দেওয়া আইডি — রিট্রাইয়ে ডুপ্লিকেট ঠেকায় (§ ২.১-ঘ)
  clientUuid   String       @unique @map("client_uuid") @db.Uuid
  /// startedAt-এর Asia/Dhaka তারিখ
  workDate     DateTime     @map("work_date") @db.Date
  state        SegmentState
  startedAt    DateTime     @map("started_at") @db.Timestamptz(3)
  endedAt      DateTime     @map("ended_at") @db.Timestamptz(3)
  /// monotonic clock থেকে — PC-র ঘড়ি বদলালেও অটুট
  durationSec  Int          @map("duration_sec")
  /// 0–100, ওই খণ্ডে কতটা অ্যাক্টিভ ছিল। কীলগিং নয়।
  inputScore   Int?         @map("input_score") @db.SmallInt
  /// = (state == active); ingest-এ সেট হয়
  countsAsWork Boolean      @default(false) @map("counts_as_work")

  session  WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee Employee    @relation(fields: [employeeId], references: [id])
  device   Device      @relation(fields: [deviceId], references: [id])

  @@index([employeeId, workDate, state])
  @@index([startedAt])
  @@map("activity_segments")
}

model Screenshot {
  id           BigInt    @id @default(autoincrement())
  employeeId   Int       @map("employee_id")
  deviceId     Int       @map("device_id")
  clientUuid   String    @unique @map("client_uuid") @db.Uuid
  workDate     DateTime  @map("work_date") @db.Date
  /// ৫ মিনিটের স্লটের শুরু
  slotStart    DateTime  @map("slot_start") @db.Timestamptz(3)
  /// আসল র‍্যান্ডম সময় — স্লটের ভেতরে কখন ছবি উঠল
  capturedAt   DateTime  @map("captured_at") @db.Timestamptz(3)
  monitorIndex Int       @default(0) @map("monitor_index") @db.SmallInt
  filePath     String    @map("file_path")
  thumbPath    String?   @map("thumb_path")
  width        Int?
  height       Int?
  sizeBytes    Int?      @map("size_bytes")
  activeApp    String?   @map("active_app")
  activeTitle  String?   @map("active_title")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  /// retention job এখানে মার্ক করে, তারপর ফাইল মোছে
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])
  device   Device   @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, slotStart, monitorIndex])
  @@index([employeeId, workDate])
  @@map("screenshots")
}

model AppUsage {
  id          BigInt   @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  deviceId    Int      @map("device_id")
  clientUuid  String   @unique @map("client_uuid") @db.Uuid
  workDate    DateTime @map("work_date") @db.Date
  startedAt   DateTime @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime @map("ended_at") @db.Timestamptz(3)
  durationSec Int      @map("duration_sec")
  processName String   @map("process_name")
  appName     String?  @map("app_name")
  windowTitle String?  @map("window_title")
  /// ⚠️ শুধু ডোমেইন — ফুল URL কখনো নয় (ADR-013)
  domain      String?
  categoryId  Int?     @map("category_id")
  isBrowser   Boolean  @default(false) @map("is_browser")
  /// ⭐ R22a — খণ্ডটা কোন অবস্থায় দেখা হয়েছে।
  /// ⚠️ ডিফল্ট `active`: পুরোনো এজেন্ট ঘরটা পাঠায় না, আর তারা যা পাঠাত
  /// তার সবই সংজ্ঞা অনুযায়ী ACTIVE — তাই পুরোনো সারির মানে বদলায় না।
  /// ⚠️⚠️ `idle` সারি **কোনো হিসাবে যায় না**; পড়ার প্রতিটা জায়গায়
  /// `segmentState: 'active'` ছাঁকনি বসানো।
  segmentState SegmentState @default(active) @map("segment_state")

  employee Employee     @relation(fields: [employeeId], references: [id])
  device   Device       @relation(fields: [deviceId], references: [id])
  category AppCategory? @relation(fields: [categoryId], references: [id])

  @@index([employeeId, workDate])
  /// ⭐ R22b-র overlap কোয়েরির জন্য — idle সেগমেন্টের সাথে সময় মেলাতে
  /// `work_date` নয়, `started_at` ধরে খুঁজতে হবে
  @@index([employeeId, startedAt])
  @@index([domain])
  @@map("app_usage")
}

model AppCategory {
  id          Int          @id @default(autoincrement())
  matchType   MatchType    @map("match_type")
  /// 'code.exe' | 'facebook.com' | regex
  pattern     String
  displayName String       @map("display_name")
  category    Productivity
  priority    Int          @default(100)

  appUsage AppUsage[]

  @@map("app_categories")
}

// ══════════════════════════ events ও audit ══════════════════════════

model Event {
  id         BigInt   @id @default(autoincrement())
  deviceId   Int?     @map("device_id")
  employeeId Int?     @map("employee_id")
  clientUuid String   @unique @map("client_uuid") @db.Uuid
  /// agent_start | agent_stop | logon | logoff | lock | unlock | sleep | resume
  /// agent_crash | clock_drift | screenshot_skipped | day_rollover | segment_split
  type       String
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  meta       Json?
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  device   Device?   @relation(fields: [deviceId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([employeeId, occurredAt])
  @@map("events")
}

/// ⚠️ time_claims টেবিল নেই — স্টাফের চাওয়ার কোনো ব্যবস্থা নেই (ADR-011d)।
/// এটি আলাদা জিনিস: সিস্টেমের নিজের দোষে হারানো ঘণ্টা owner ফেরত দেয় (ADR-011e, § ২.১-ঙ)।
model TimeAdjustment {
  id              BigInt          @id @default(autoincrement())
  employeeId      Int             @map("employee_id")
  workDate        DateTime        @map("work_date") @db.Date
  /// + = ঘণ্টা ফেরত · − = কেটে নেওয়া
  deltaSec        Int             @map("delta_sec")
  cause           AdjustmentCause
  /// ⭐ বাধ্যতামূলক — খালি রাখা যাবে না
  reason          String
  evidenceAlertId BigInt?         @map("evidence_alert_id")
  /// মাপা downtime-এর চেয়ে বেশি দেওয়া হয়েছে? রিপোর্টে আলাদা দেখায়
  beyondEvidence  Boolean         @default(false) @map("beyond_evidence")
  /// শুধু owner
  createdById     Int             @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  /// ডিলিট নেই — শুধু revoke, রেকর্ড থেকে যায়
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz(3)
  revokedById     Int?            @map("revoked_by")
  revokeReason    String?         @map("revoke_reason")

  employee      Employee @relation(fields: [employeeId], references: [id])
  createdBy     User     @relation("AdjustmentCreatedBy", fields: [createdById], references: [id])
  revokedBy     User?    @relation("AdjustmentRevokedBy", fields: [revokedById], references: [id])
  evidenceAlert Alert?   @relation(fields: [evidenceAlertId], references: [id])

  @@index([employeeId, workDate])
  @@map("time_adjustments")
}

/// কোন অ্যাডমিন কার স্ক্রিনশট কখন দেখল — সেটাও রেকর্ড থাকে
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     Int?     @map("user_id")
  /// view_screenshot | export_report | change_setting | reset_password
  /// create_enrollment_code | revoke_device | upload_policy_doc
  /// time_adjustment | time_adjustment_revoke
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  ipAddress  String?  @map("ip_address") @db.Inet
  meta       Json?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, occurredAt])
  @@map("audit_log")
}

model Setting {
  key         String   @id
  value       Json
  updatedById Int?     @map("updated_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("settings")
}

// ══════════════════ ক্যালেন্ডার ══════════════════
// ⚠️ leave_types / leave_requests / leave_balances নেই — ইচ্ছাকৃত (ADR-011d)।

/// দুই কাজে লাগে: হিটম্যাপে দিন চিহ্নিত করা, আর pace-এর কর্মদিবস গোনা (§ ২.১-খ)।
/// ⚠️ ব্লক নয় — ছুটির দিনে কেউ কাজ করলে সেই ঘণ্টাও পুরোপুরি গোনা হবে।
model Holiday {
  id          Int      @id @default(autoincrement())
  holidayDate DateTime @unique @map("holiday_date") @db.Date
  name        String
  type        String   @default("public")

  @@map("holidays")
}

// ══════════════════ অ্যালার্ট ও এজেন্ট ভার্সন ══════════════════

model Alert {
  id               BigInt        @id @default(autoincrement())
  /// agent_down | agent_killed | disk_warning | disk_critical | backup_failed
  /// clock_drift | no_activity_today | device_overlap
  type             String
  severity         AlertSeverity
  employeeId       Int?          @map("employee_id")
  deviceId         Int?          @map("device_id")
  title            String
  detail           String?
  meta             Json?
  channelsSent     String[]      @map("channels_sent")
  acknowledgedById Int?          @map("acknowledged_by")
  acknowledgedAt   DateTime?     @map("acknowledged_at") @db.Timestamptz(3)
  // ⭐ সার্ভার নিজে অবস্থা কেটে যেতে দেখেছে (এজেন্ট ফিরে এসেছে) — মানুষ নয়।
  //    acknowledgedAt ("মানুষ দেখেছে") থেকে আলাদা: দুটো ভিন্ন ঘটনা, তাই ভিন্ন ঘর।
  //    NULL = এখনো মেটেনি; "open" মানে acknowledgedAt আর resolvedAt দুটোই NULL।
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(3)
  resolvedReason   String?       @map("resolved_reason")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  employee       Employee?        @relation(fields: [employeeId], references: [id])
  device         Device?          @relation(fields: [deviceId], references: [id])
  acknowledgedBy User?            @relation(fields: [acknowledgedById], references: [id])
  adjustments    TimeAdjustment[]

  @@index([createdAt])
  @@map("alerts")
}

model AgentVersion {
  version      String       @id
  msiPath      String       @map("msi_path")
  sha256       String
  releaseNotes String?      @map("release_notes")
  rolloutStage RolloutStage @default(canary) @map("rollout_stage")

  /**
   * ⭐⭐ **যে একটা PC বালতি নির্বিশেষে আগে পাবে** *(১ সেপ্টেম্বর ২০২৬)*।
   *
   * ⚠️⚠️ রোলআউট চলে **মেশিন ধরে** (`machineGuid`-এর হ্যাশ), মানুষ ধরে নয়।
   * ফলে যে PC-তে বাগটা ধরা পড়েছে ঠিক সেখানেই সংশোধনটা আগে পরীক্ষা করা
   * যেত না — মালিকের কথায়: *"OX-05 ei update age powa dorkar"*, অথচ তাঁর
   * বালতি ৮৬, আর canary ৭ · partial ৫০।
   *
   * ⚠️ `halted`-এ পাইলটও বাদ — জরুরি ব্রেক সবার জন্য।
   */
  pilotDeviceId Int?    @map("pilot_device_id")
  pilotDevice   Device? @relation("agentVersionPilot", fields: [pilotDeviceId], references: [id])
  isMandatory  Boolean      @default(false) @map("is_mandatory")
  releasedAt   DateTime     @default(now()) @map("released_at") @db.Timestamptz(3)

  @@map("agent_versions")
}

// ══════════════════ rollup — রিপোর্ট দ্রুত করার জন্য ══════════════════
// প্রতি ১৫ মিনিটে ও দিন-ক্লোজে (০০:১৫) রিফ্রেশ হয়

/// ⚠️ target / shortfall / overtime / late / attendance এখানে নেই —
///    দৈনিক কোনো টার্গেটই নেই। সব টার্গেট-হিসাব MonthlySummary-তে।
/**
 * ⭐⭐ **একটা ডিজাইন প্রথম কবে দেখা গেল** *(২১ আগস্ট ২০২৬)*।
 *
 * ⚠️⚠️ **কেন আলাদা টেবিল, রোজ গুনে নেওয়া নয়।** "আজ কতগুলো ডিজাইন" প্রশ্নের
 * সৎ উত্তর হলো **নতুন** ডিজাইনের সংখ্যা — গতকালের ফাইল আজ আবার খুললে সেটা
 * আজকের কাজ নয়। মাঠে মেপে দেখা গেছে তফাতটা বড়: একজনের ৩৯ নেমে দাঁড়ায়
 * **২৪**-এ। কিন্তু "নতুন কি না" জানতে হলে **পুরো ইতিহাস** দেখতে হয়, আর
 * সেটা রোজ স্ক্যান করা এক বছর পর ব্যয়বহুল হয়ে উঠত।
 *
 * ⭐ তাই প্রতিটা (কর্মী, ডিজাইন) জোড়া **একবারই** বসে, আর প্রাথমিক কী-ই
 * দ্বিতীয়বার বসতে দেয় না। "আজ কতগুলো" = `first_work_date` আজকের এমন সারি।
 *
 * ⚠️ **ডিজাইনের নাম এখানে জমা হয় না** — কেবল সামনের নম্বরটা। মালিকের
 * শর্ত (২১ আগস্ট): শিরোনাম পড়া যাবে, কিন্তু নাম কোথাও রাখা বা দেখানো নয়।
 */
/**
 * ⭐⭐ **গবেষকের জমা করা ডিজাইন-টার্গেট** *(২২ আগস্ট ২০২৬)*।
 *
 * গবেষকেরা রোজ ~৫০০টা Amazon T-shirt URL জমা করেন; সেখান থেকে
 * ডিজাইনারদের মধ্যে র‍্যান্ডম বণ্টন হয়।
 *
 * ⚠️⚠️ **পরিচয় ASIN, URL নয়** — আর `@unique` ওখানেই। একই পণ্যের URL
 * অসংখ্য রকম হয় (`?th=1`, `ref=sr_1_3`, `.co.uk`); URL ধরে ডুপ্লিকেট
 * খুঁজলে তিনজন ডিজাইনার একই ডিজাইন বানাতেন।
 *
 * ⚠️ মূল URL **জমা রাখা হয় না** — মালিকের নিয়ম (২২ আগস্ট): ASIN বসিয়ে
 * `https://www.amazon.com/dp/…` বানিয়ে নিলেই হয়। রাখলে একই জিনিসের
 * দুটো চেহারা টেবিলে থাকত।
 */
model DesignTarget {
  id     Int                @id @default(autoincrement())
  /// ⚠️ ঠিক ১০ অক্ষর, বড় হাতে সাজানো — `targets.rules.ts` দেখুন
  asin   String             @unique @db.VarChar(10)
  status DesignTargetStatus @default(pool)

  /**
   * ⭐⭐ বরাদ্দের সময় দেওয়া নম্বর — ডিজাইনার এটাই ফাইলের নামে বসাবেন
   * (`1000042-Funny Cat T-Shirt.ai`), আর তা থেকেই "শেষ হয়েছে" ধরা পড়ে।
   *
   * ⚠️ শুরু **১০,০০,০০০** থেকে, আর সেটা মাপা সংখ্যা: চলতি ফাইলগুলোয়
   * সবচেয়ে বড় নম্বর ৯,৭৩,০৬৫। কম থেকে শুরু করলে পুরোনো কোনো ফাইল ভুল
   * করে টার্গেট বন্ধ করে দিত।
   */
  jobNumber Int? @unique @map("job_number")

  /// ⚠️ কে জমা দিলেন — গবেষক, ম্যানেজার বা মালিক
  addedById Int      @map("added_by_id")
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  assignedToId Int?      @map("assigned_to_id")
  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz(3)

  /**
   * ⭐⭐ **কাজ শুরু হয়েছে** — ফাইলটা প্রথমবার খোলা হয়েছে *(২৩ আগস্ট)*।
   *
   * ⚠️⚠️ **"খোলা" আর "শেষ" এক নয়, আর প্রথমে সেটা গুলিয়ে ফেলা হয়েছিল।**
   * এজেন্ট শিরোনাম থেকে নম্বরটা তখনই দেখে যখন ফাইলটা **সামনে আসে** —
   * অর্থাৎ কাজ শুরুর মুহূর্তে। ওটাকে "শেষ" ধরলে টার্গেট খোলামাত্র বন্ধ
   * হয়ে যেত, আর ডিজাইনার পরদিন সেটা তালিকায় খুঁজেই পেতেন না।
   *
   * ⭐ তাই স্বয়ংক্রিয় সংকেতটা এখানে বসে, আর **শেষ হওয়া বলেন ডিজাইনার
   * নিজে** (Complete বোতাম)। সিস্টেম যা সত্যিই জানে সেটুকুই বলে।
   */
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  /**
   * ⭐⭐ **কে "শেষ" বলেছেন** *(২৩ আগস্ট ২০২৬, মালিকের রিপোর্ট)*।
   *
   * ⚠️⚠️ `completedVia` বলে **কীভাবে** হয়েছে (`manual` / `filename`),
   * কিন্তু **কে** করেছেন সেটা কোথাও লেখা হতো না। ফলে তালিকায় যাঁর নাম
   * দেখা যেত তিনি ছিলেন **যাঁকে বরাদ্দ করা হয়েছিল** — মালিক নিজে
   * Complete চাপলেও ডিজাইনারের নামই দেখাত, যা সরাসরি ভুল তথ্য।
   *
   * ⭐ `User`-এর সাথে জোড়া, `Employee`-এর নয়: দুটো পথেই (ডিজাইনারের
   * নিজের পাতা আর মালিকের তালিকা) যিনি চাপেন তিনি লগইন করা ব্যবহারকারী।
   * Employee-তে জুড়লে মালিক/ম্যানেজারের কোনো সারিই থাকত না।
   */
  completedById Int?    @map("completed_by_id")
  completedBy   User?   @relation("designTargetCompletedBy", fields: [completedById], references: [id])

  /// ⭐⭐ **বানান দেখা হয়েছে** (ADR-038, ২৫ আগস্ট ২০২৬)।
  ///
  /// ⚠️⚠️ **অবস্থা নয়, তারিখ** — `uploaded_at`/`live_at`-এর মতোই। নতুন
  /// অবস্থা বানালে সারিটা `done` থেকে সরে যেত, আর গোটা সিস্টেমে
  /// "কতগুলো ডিজাইন হয়েছে" সব গণনা নীরবে কমে যেত।
  ///
  /// ⚠️ `null` = **এখনো দেখা হয়নি**, "ভুল নেই" নয় — দুটো আলাদা।
  /**
   * ⭐⭐ **বাদ-যাওয়া সারিটা মালিক/ম্যানেজার দেখে নিয়েছেন** *(৩১ আগস্ট ২০২৬)*।
   *
   * ⚠️⚠️ **`NULL` মানেই কিউতে আছে**, আর সেটাই কিউয়ের একমাত্র শর্ত (সাথে
   * `dropReason != null`)। ⭐ চিহ্নটা না থাকলে তালিকাটা কোনোদিন খালি হতো
   * না — আর ২৪ আগস্টে ঠিক সেই ভুলে আপলোড-কিউতে ২৭,৬৪১টা সারি দাঁড়িয়ে
   * গিয়েছিল (`UPLOAD_QUEUE_FROM`-এর টীকা)।
   *
   * ⚠️ পুলে ফেরত পাঠালে এটাও মুছে যায় — সারিটা তখন আর বাদ-যাওয়া নয়,
   * অর্থাৎ "দেখা হয়েছে" কথাটার কোনো বিষয়ই থাকে না।
   */
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedById Int?      @map("reviewed_by_id")
  reviewedBy   User?     @relation("designTargetReviewedBy", fields: [reviewedById], references: [id])

  checkedAt    DateTime? @map("checked_at") @db.Timestamptz(3)
  checkedById  Int?      @map("checked_by_id")
  checkedBy    User?     @relation("designTargetCheckedBy", fields: [checkedById], references: [id])

  /// ⭐ **ভুল পাওয়া গেছে** — `null` মানে দেখা হয়েছে আর ঠিক ছিল
  /// (যদি `checked_at` বসানো থাকে), বা এখনো দেখাই হয়নি।
  errorFoundAt DateTime? @map("error_found_at") @db.Timestamptz(3)

  /// ⭐ **ভুলটা ঠিক করা হয়েছে**।
  ///
  /// ⚠️⚠️ `assigned_to_id` **কখনো বদলায় না** — ডিজাইনটা মূল ডিজাইনারেরই
  /// থাকে। নইলে যিনি ঠিক করলেন তাঁর নামে কাজটা চলে যেত, আর ২৩ আগস্টের
  /// গোটা তদন্তটা শুরুই হয়েছিল ঠিক এমন একটা ফুলে যাওয়া সংখ্যা দেখে।
  fixedAt      DateTime? @map("fixed_at") @db.Timestamptz(3)
  fixedById    Int?      @map("fixed_by_id")
  fixedBy      User?     @relation("designTargetFixedBy", fields: [fixedById], references: [id])
  /**
   * ⭐⭐ **আপলোড হয়েছে** *(২৩ আগস্ট ২০২৬, মালিকের চাওয়া)*।
   *
   * ⚠️⚠️ **নতুন অবস্থা নয়, তারিখ** — ঠিক `startedAt`/`completedAt`-এর মতো।
   * `status`-এ ঢোকালে একটা কাজ "done" থেকে "uploaded" হয়ে যেত, আর
   * `status = 'done'` ধরে যত গণনা আছে সব নীরবে কমে যেত। তারিখ হিসেবে
   * রাখলে **সবগুলো ধাপই একসাথে সত্যি থাকে**, আর কবে কোনটা হলো তাও জানা যায়।
   */
  uploadedAt  DateTime? @map("uploaded_at") @db.Timestamptz(3)
  /**
   * ⭐ **Amazon-এ লাইভ হয়েছে** — অর্থাৎ বিক্রির জন্য উঠেছে।
   *
   * ⚠️ আপলোড আর লাইভ এক নয়: Amazon পর্যালোচনা করে, বাতিলও করে। দুটো
   * আলাদা রাখায় পাইপলাইনের ফুটোটা দেখা যায় — কতগুলো আপলোড হয়ে **আটকে
   * আছে বা বাতিল হয়েছে**।
   */
  liveAt      DateTime? @map("live_at") @db.Timestamptz(3)
  /**
   * ⭐⭐ লাইভ হওয়া **নতুন** পণ্যের ASIN।
   *
   * ⚠️⚠️ উপরের `asin`-এর সাথে গুলিয়ে ফেলা যাবে না — ওটা গবেষকের খুঁজে
   * আনা **নমুনা** পণ্য (যা দেখে ডিজাইন হয়েছে), আর এটা আমাদের নিজের
   * **বিক্রয়যোগ্য** পণ্য। একই ঘরে রাখলে "কোনটা কার" চিরকাল ধোঁয়াশা থাকত।
   *
   * ⭐ এই ঘরটাই ভবিষ্যতে বিক্রির হিসাবের সাথে জোড়া লাগার সেতু — পরিশ্রম
   * থেকে ফল পর্যন্ত।
   */
  liveAsin    String?   @map("live_asin") @db.VarChar(20)
  /**
   * ⭐⭐ **শেষ যা ঘটেছে** *(২৩ আগস্ট ২০২৬)* — তালিকার ক্রম ও তারিখ-ফিল্টারের ভিত্তি।
   *
   * ⚠️⚠️ **ডাটাবেসে স্বয়ংগণিত** (`GENERATED ALWAYS AS ... STORED`) — কোড
   * এতে কখনো লেখে না, লিখতে গেলে PostgreSQL নিজেই আটকাবে। তাই "কেউ
   * হালনাগাদ করতে ভুলে গেল" বলে কোনো অবস্থা তৈরি হতে পারে না।
   *
   * ⭐ `GREATEST` NULL উপেক্ষা করে, আর `addedAt` NOT NULL — তাই ঘরটা
   * কখনো খালি থাকে না, এমনকি পুলে পড়ে থাকা সারিতেও।
   *
   * ⚠️ Prisma-তে ঐচ্ছিক (`?`) লেখা হয়েছে যাতে কোনো `create` একে বাধ্যতামূলক
   * না ভাবে — আসল ডাটাবেসে ঘরটা কখনো NULL হয় না।
   */
  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz(3)
  /// `filename` (নিজে থেকে ধরা) বা `manual` (ডিজাইনার নিজে বলেছেন)
  completedVia String? @map("completed_via") @db.VarChar(16)

  /**
   * ⭐⭐ **কেন সারিটা চলে গেল** *(৩১ আগস্ট ২০২৬)* — `not_found` ·
   * `copyright` · `events`।
   *
   * ⚠️⚠️ **এক ঘর, দুই পথ:** ডিজাইনারের Skip আর মালিকের Delete — দুটোই
   * এখানেই লেখে। কোন পথে গেছে সেটা `status` বলে, তাই কারণটা দুবার রাখার
   * দরকার নেই। ⭐ আগে নাম ছিল `skipped_reason`, কিন্তু ৯৩টা skipped
   * সারির একটাতেও কিছু লেখা ছিল না — পর্দা কোনোদিন কারণ পাঠাত না।
   *
   * ⚠️ **যন্ত্রের মান জমা হয়, পর্দার লেখা নয়** (`not_found`, "Not Found"
   * নয়) — নইলে একদিন লেখাটা বদলালে পুরোনো সব সারি অন্য জিনিস বোঝাত।
   * তালিকাটা এক জায়গায়: `targets.rules.ts`-এর `DROP_REASONS`।
   */
  dropReason String? @map("drop_reason") @db.VarChar(16)

  /**
   * ⭐⭐ **oXeio-র আগে এই সারিটা কোথায় ছিল** *(২২ আগস্ট, ইমপোর্ট)*।
   *
   * পুরোনো Excel-এ নাম ও তারিখ এক ঘরে মেশানো ছিল
   * (`Hafiz-29-07-2026`, `Salman 03.01.2026`, `বেলাল`), আর তার ভেতরে
   * ছিল **ছেড়ে যাওয়া কর্মীদের নামও** (rony · aman · eshaan · tamim…)।
   *
   * ⚠️⚠️ তাই ওগুলো `assignedToId`-তে বসানো **যায়নি** — FK-টা কর্মী-সারিতে
   * বাঁধা, আর যাঁরা নেই তাঁদের জন্য সারি বানানো মানে ইতিহাসকে বর্তমান
   * বলে চালানো। ⭐ কিন্তু মুছেও ফেলা হয়নি: কাঁচা লেখাটা এখানে থাকল,
   * যাতে "এই ডিজাইনটা কে করেছিল" প্রশ্নের উত্তর হারিয়ে না যায়।
   *
   * ⚠️ `null` মানে সারিটা oXeio-তেই জন্মেছে, ইমপোর্ট নয়।
   */
  sourceNote String? @map("source_note")

  addedBy    User      @relation("addedTargets", fields: [addedById], references: [id])
  assignedTo Employee? @relation(fields: [assignedToId], references: [id])

  /// ⭐ বণ্টনের সময় পুল থেকে বাছতে — `WHERE status = 'pool'`
  @@index([status])
  /// ⭐ ডিজাইনারের নিজের তালিকা
  @@index([assignedToId, status])
  @@map("design_targets")
}

model DesignCredit {
  employeeId    Int      @map("employee_id")
  /// ফাইলের নামের সামনের নম্বর — যেমন `37933`
  designId      String   @map("design_id") @db.VarChar(16)
  /// ঢাকার যে দিনে এটা **প্রথম** চোখে পড়েছে
  firstWorkDate DateTime @map("first_work_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([employeeId, designId])
  @@index([employeeId, firstWorkDate])
  @@map("design_credits")
}

model DailySummary {
  employeeId      Int       @map("employee_id")
  workDate        DateTime  @map("work_date") @db.Date
  firstActivityAt DateTime? @map("first_activity_at") @db.Timestamptz(3)
  lastActivityAt  DateTime? @map("last_activity_at") @db.Timestamptz(3)
  activeSec       Int       @default(0) @map("active_sec")
  /// লাঞ্চ / চা / বিরতি সব এখানেই — আলাদা করে ট্র্যাক হয় না (ADR-011)
  idleSec         Int       @default(0) @map("idle_sec")
  /// ⭐ প্রকৃত ACTIVE-এর UNION (§ ২.১-গ) — এই সংখ্যা কখনো এডিট হয় না
  workedSec       Int       @default(0) @map("worked_sec")
  /// ⭐ owner-এর সংশোধন, ± (§ ২.১-ঙ)
  adjustmentSec   Int       @default(0) @map("adjustment_sec")
  /// ⭐ worked + adjustment → মাসিক টার্গেটে এটাই যায়
  creditedSec     Int       @default(0) @map("credited_sec")
  /// দিনের প্রথম ও শেষ active ঘণ্টা (0–23) — তথ্য মাত্র, বিচারের মাপকাঠি নয়
  earliestHour    Int?      @map("earliest_hour") @db.SmallInt
  latestHour      Int?      @map("latest_hour") @db.SmallInt
  productiveSec   Int       @default(0) @map("productive_sec")
  unproductiveSec Int       @default(0) @map("unproductive_sec")
  productivityPct Decimal?  @map("productivity_pct") @db.Decimal(5, 2)
  screenshotCount Int       @default(0) @map("screenshot_count")
  /**
   * ⭐⭐ **আজ কতগুলো নতুন ডিজাইন** (ডিজাইনারদের জন্য) — [DesignCredit] থেকে গোনা।
   *
   * ⚠️ এখানে **জমিয়ে রাখা** হয় ইচ্ছাকৃতভাবে: Worklog · টেলিগ্রাম রিপোর্ট ·
   * মাসিক Excel · কর্মীর নিজের পাতা — চারটেই এই এক সংখ্যাটাই পড়ে, তাই
   * চারটে আলাদা হিসাব কোনোদিন দ্বিমত করতে পারে না।
   * ⚠️ ডিজাইনার নন এমন কারো জন্য এটা সবসময় ০ — সেটা "কাজ করেননি" নয়,
   * "এই মাপটা তাঁর জন্য নয়"। পর্দায় তাই কলামটাই দেখানো হয় না।
   */
  designsDone     Int       @default(0) @map("designs_done")
  dayType         DayType?  @map("day_type")
  computedAt      DateTime  @default(now()) @map("computed_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([employeeId, workDate])
  @@map("daily_summary")
}

/// ⭐ প্রধান রিপোর্টিং টেবিল — একমাত্র মাপকাঠি এখানেই
/**
 * ⭐⭐ **পুরোনো বেতন** *(২৩ আগস্ট ২০২৬)* — যাতে অতীতের পে-রোল না নড়ে।
 *
 * ⚠️⚠️ **কেন দরকার হলো।** [R1](../../docs/10-Roadmap.md) মাস বন্ধ করে
 * *ঘণ্টা* সুরক্ষিত করেছে — বন্ধ মাসে `refreshMonth()` আর ছোঁয় না। কিন্তু
 * পে-রোল বেতনের সংখ্যাটা নেয় `employees.monthly_salary` থেকে, **লাইভ**।
 * ফলে কারো বেতন বাড়ালে **বন্ধ মাসের পে-রোলও নীরবে বদলে যেত**, আর যে
 * কাগজে বেতন দেওয়া হয়েছিল তার সাথে আর মিলত না।
 *
 * ⭐⭐ **R1 স্ন্যাপশট টেবিল ইচ্ছাকৃতভাবে বাদ দিয়েছিল** — *"সংখ্যা কপি করা
 * মানে একই সংখ্যা দু'জায়গায় রাখা, আর তখন 'কোনটা সত্যি' প্রশ্নটা চিরকালের
 * জন্য খুলে যেত"*। এই টেবিল সেই ভুল করে না, কারণ **কোনো overlap নেই**:
 *
 * | প্রশ্ন | উত্তর কোথায় |
 * |---|---|
 * | এখন কত বেতন? | `employees.monthly_salary` — একটাই ঘর |
 * | ২০২৬-০৭-এ কত ছিল? | এখানকার সারি, যদি থাকে |
 *
 * ⚠️ সারি বসে **কেবল বেতন বদলালে** — পুরোনো মানটা "কোন মাস পর্যন্ত
 * চলেছিল" সহ। বদল না হলে টেবিল খালি, আর পে-রোল আগের মতোই কর্মীর ঘর
 * থেকে পড়ে। অর্থাৎ **যা বদলায়নি তার কোনো নকল নেই**।
 */
model SalaryPeriod {
  id            Int      @id @default(autoincrement())
  employeeId    Int      @map("employee_id")
  /**
   * 'YYYY-MM' — **এই মাস পর্যন্ত (অন্তর্ভুক্ত)** এই বেতনই ছিল।
   *
   * ⚠️ "কবে থেকে" নয়, "কোন মাস পর্যন্ত" — কারণ প্রশ্নটা সবসময় অতীত নিয়ে
   *    ("জুলাইয়ে কত ছিল?"), আর এভাবে লিখলে সবচেয়ে ছোট `through_month >=
   *    ওই মাস` সারিটাই উত্তর। "কবে থেকে" রাখলে শেষ সারির পরে একটা খোলা
   *    সীমা থাকত, আর সেটা এখনকার বেতনের সাথে ঠোকাঠুকি খেত।
   */
  throughMonth  String   @map("through_month") @db.Char(7)
  monthlySalary Decimal  @map("monthly_salary") @db.Decimal(12, 2)
  /// কে বদলাল ও কেন — audit-এ সারি থাকে, কিন্তু পে-রোল পর্দায় এটাই কাছে
  note          String?
  changedById   Int?     @map("changed_by_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  /// ⚠️ একই কর্মীর একই মাসের জন্য দুটো সারি থাকলে "কোনটা সত্যি" ফিরে আসত
  @@unique([employeeId, throughMonth])
  @@index([employeeId])
  @@map("salary_periods")
}

model MonthlySummary {
  employeeId       Int       @map("employee_id")
  /// '2026-08'
  yearMonth        String    @map("year_month") @db.Char(7)
  /// কাঁচা হিসাব
  workedSec        Int       @default(0) @map("worked_sec")
  adjustmentSec    Int       @default(0) @map("adjustment_sec")
  /// ⭐ worked + adjustment — টার্গেটের সাথে এটাই মেলানো হয়
  creditedSec      Int       @default(0) @map("credited_sec")
  /// ২০৮ ঘণ্টা
  targetSec        Int       @default(748800) @map("target_sec")
  /// আজ পর্যন্ত যত হওয়ার কথা (§ ২.১-খ)
  expectedSec      Int       @default(0) @map("expected_sec")
  /// credited − expected · ধনাত্মক = এগিয়ে
  paceSec          Int       @default(0) @map("pace_sec")
  /// ⭐ **তার নিজের** কর্মদিবস (d) — joined_on … left_on-এর ভেতরে যতগুলো পড়ে।
  /// ⚠️ G37-এর আগে এটা ছিল "ওই মাসের মোট কর্মদিবস"; মানেটা বদলেছে (ADR-025)।
  expectedWorkdays Int       @map("expected_workdays")
  /// ⭐ ওই মাসের মোট কর্মদিবস (D) — বেতনের ভগ্নাংশ d÷D-এর হর।
  /// ⚠️ আলাদা করে রাখা হয়, পে-রোলের সময় আবার গোনা হয় না: ছুটির তালিকা
  /// বদলালে d আর D দুই আলাদা সময়ের হিসাব হয়ে যেত, আর ভগ্নাংশটা ভুল হতো।
  monthWorkdays    Int       @default(0) @map("month_workdays")
  /// ⭐ R2 — অনুমোদিত ছুটির কর্মদিবস। টার্গেট কমায়, `d ÷ D` ছোঁয় না।
  leaveWorkdays    Int       @default(0) @map("leave_workdays")
  /// ⭐ আজ পর্যন্ত কত কর্মদিবস গেছে
  workdaysElapsed  Int       @default(0) @map("workdays_elapsed")
  daysWithWork     Int       @default(0) @map("days_with_work")
  avgDailySec      Int       @default(0) @map("avg_daily_sec")
  overtimeSec      Int       @default(0) @map("overtime_sec")
  shortfallSec     Int       @default(0) @map("shortfall_sec")
  targetMet        Boolean   @default(false) @map("target_met")
  targetMetAt      DateTime? @map("target_met_at") @db.Timestamptz(3)
  computedAt       DateTime  @default(now()) @map("computed_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([employeeId, yearMonth])
  @@map("monthly_summary")
}

/**
 * R1 — **মাস বন্ধ করা।**
 * ⚠️⚠️ যে সমস্যাটা এটা সারায়: `monthly_summary`-র প্রতিটা সংখ্যা
 * `refreshMonth()` **প্রতিবার নতুন করে গোনে**, আর গোনার সময় ওই মুহূর্তের
 * `holidays` টেবিল পড়ে। তাই ছুটির একটা তারিখ নড়লে — বা পুরোনো মাসের কোনো
 * সময়-সংশোধন অনুমোদন হলে — **গত মাসের `target_sec` · `expected_sec` ·
 * `expected_workdays` (d) · `month_workdays` (D) চারটেই পিছন ফিরে বদলায়**।
 * পে-রোল ওই সারি থেকেই d ও D পড়ে, অর্থাৎ বেতন দিয়ে দেওয়ার পরেও হিসাব
 * নড়তে পারত, আর কোন সংখ্যায় বেতন হয়েছিল তা প্রমাণ করার উপায় থাকত না।
 * ⭐⭐ **সারি এখানে, সংখ্যা নয়।** রোডম্যাপে "স্ন্যাপশট টেবিল" লেখা ছিল,
 * কিন্তু তাতে একই মাসের **দুটো** সংখ্যা তৈরি হতো — লাইভ আর জমাট — আর
 * "দুই পর্দায় দুই সংখ্যা" এই রিপোর সবচেয়ে বড় পাপ (G88)। বদলে সংখ্যাগুলো
 * `monthly_summary`-তেই **জায়গামতো জমাট** হয়: মাস বন্ধ থাকলে
 * `refreshMonth()` ওই মাস আর ছোঁয় না, আর সংশোধন ঢুকতে চাইলে ৪০৯।
 * এই টেবিলটা কেবল **কে কখন বন্ধ করল** তার রেকর্ড।
 * ⭐ চাবি শুধু `year_month` — মাস সবার জন্য একসাথে বন্ধ হয়, একজন-একজন করে
 * নয়। কর্মীপ্রতি বন্ধ করা গেলে "আগস্ট বন্ধ কি না" প্রশ্নের উত্তর হতো
 * "কার জন্য?" — আর পে-রোল চলে পুরো মাস ধরে।
 */
model MonthClosure {
  /// '2026-08'
  yearMonth String   @id @map("year_month") @db.Char(7)
  closedAt  DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)
  /// ⚠️ ইমেইল, `user_id` নয় — ইউজার মুছে গেলেও "কে বন্ধ করেছিল" টিকে থাকা দরকার
  closedBy  String   @map("closed_by")
  /// কেন, বা কিসের ভিত্তিতে — ঐচ্ছিক
  note      String?

  @@map("month_closures")
}

/**
 * R2 — **ছুটির খাতা।**
 * ⚠️⚠️ **কোনো আবেদন-অনুমোদন প্রবাহ নয়** — "স্টাফের চাপার মতো কোনো বোতাম
 * নেই" এই সিস্টেমের ঘোষিত নিয়ম। স্টাফ মুখে বলেন, owner লিখে রাখেন।
 * তাই এখানে `status`/`approvedBy` জাতীয় কোনো ঘর নেই, আর থাকা উচিতও নয়।
 * ⭐⭐ **এক সারি = এক দিন**, তারিখের সীমা নয়। পর্দা সীমা নেয় ("৩–৭ আগস্ট")
 * আর সেটাকে দিনে ভেঙে বসায়। কারণ গোনা, বাদ দেওয়া আর একটা দিন মুছে ফেলা —
 * তিনটেই তখন তুচ্ছ; সীমা রাখলে প্রতিটা হিসাবে ওভারল্যাপ ও আংশিক-ছেদ
 * সামলাতে হতো, আর ওখানেই বাগ জন্মাত।
 * ⭐⭐ **ছুটি ঘণ্টার টার্গেট কমায়, বেতন নয়** — অর্থাৎ **সবেতন**।
 * `monthly_summary.expected_workdays` (d) অপরিবর্তিত থাকে, তাই পে-রোলের
 * `d ÷ D` ভগ্নাংশও অটুট। কমে কেবল `target_sec` ও `expected_sec`।
 * ⚠️ উল্টোটা (d কমানো) মানে ছুটি নিলেই নীরবে বেতন কাটা — সেটা মালিকের
 * সজ্ঞান সিদ্ধান্ত ছাড়া করা যায় না।
 * ⚠️ ছুটির দিনে কেউ কাজ করলে ঘণ্টা **গোনা হবেই** — ছুটি মানে টার্গেট মাফ,
 * কাজ নিষেধ নয় (§ ২.১-খ-এর নিয়ম ছুটিতেও এক)।
 */
model Leave {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  /// ঢাকার কর্মদিবস — `holidays.holiday_date`-এর মতোই UTC-মধ্যরাত
  leaveDate  DateTime @map("leave_date") @db.Date
  /// `casual` · `sick` · `annual` — **তিনটেই সবেতন**
  ///
  /// ⚠️⚠️ `unpaid` ইচ্ছাকৃতভাবে **নেই**। বিনা-বেতনের ছুটি d (`d ÷ D`-র লব)
  /// কমাত, অথচ এখানকার সব কোড ছুটিকে সবেতন ধরে। নামটা রেখে দিলে খাতায়
  /// `unpaid` লেখা থাকত আর বেতন কাটত না — সংখ্যাটা এমন কিছু দাবি করত যা
  /// সে জানে না। দরকার হলে সেটা পে-রোলের আলাদা সিদ্ধান্ত।
  type       String   @default("casual")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// ⚠️ ইমেইল, `user_id` নয় — ইউজার মুছে গেলেও "কে লিখেছিল" টিকে থাকা দরকার
  createdBy  String   @map("created_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  /// ⭐ একই দিনে দুবার ছুটি লেখা যায় না — নইলে গোনায় দুবার বাদ যেত
  @@unique([employeeId, leaveDate])
  @@index([leaveDate])
  @@map("leaves")
}

/**
 * R21 — **সিকিউরিটি মানি (জামানত): নিয়মটা।**
 * ⭐⭐ **একটাই সারি** (`id = 1`)। অঙ্কটা সবার জন্য এক — মালিকের সিদ্ধান্ত,
 * ১৫ আগস্ট। কর্মীভেদে আলাদা করা গেলে `employees`-এ একটা কলামই যথেষ্ট হতো,
 * কিন্তু তখন "কার কত" প্রশ্নের উত্তর ১২ জায়গায় ছড়িয়ে থাকত, আর একজনের ঘর
 * ফাঁকা থাকলে সেটা "শূন্য" না "ডিফল্ট" তা বোঝার উপায় থাকত না।
 * ⚠️⚠️ **এখানকার অঙ্ক বদলালে পুরোনো কিস্তি বদলায় না** — কারণ প্রতিটা মাসের
 * কিস্তি `security_deposits`-এ **লিখে রাখা** হয়, প্রতিবার নতুন করে গোনা
 * হয় না। উল্টোটা করলে আজ ৫০০ থেকে ৬০০ করলে গত ছ-মাসের জমাও পিছন ফিরে
 * বেড়ে যেত — আর কর্মী যে টাকাটা কখনো দেননি, খাতা সেটা দাবি করত।
 */
model DepositPolicy {
  /// ⚠️ সবসময় ১ — একাধিক সারি হওয়ার পথ বন্ধ (`@default(1)` নয়, কোড বসায়)
  id             Int      @id
  /// প্রতি মাসে কত, **পয়সায়** — ৫০০ টাকা = ৫০০০০
  amountPaisa    Int      @map("amount_paisa")
  /// কোন মাস থেকে কাটা শুরু — '2026-08'
  startYearMonth String   @map("start_year_month") @db.Char(7)
  /// ⭐ ছাড়ার কত দিন আগে জানাতে হয় — কম হলে জমা টাকা বাজেয়াপ্ত
  noticeDays     Int      @default(30) @map("notice_days")
  /// ⚠️ বন্ধ করলে নতুন কিস্তি বসা থামে, **পুরোনো জমা অটুট থাকে**
  active         Boolean  @default(true)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// ⚠️ ইমেইল, `user_id` নয় — ইউজার মুছে গেলেও "কে বদলেছিল" টিকে থাকে
  updatedBy      String   @map("updated_by")

  @@map("deposit_policy")
}

/**
 * R21 — **জামানতের খাতা: এক সারি = এক কর্মীর এক মাসের কিস্তি।**
 * ⭐⭐ কেন হিসাব করে বের না করে **লিখে রাখা হয়**: জমা টাকা একটা **ঘটনার
 * ইতিহাস**, আজকের নিয়মের ফল নয়। কেউ ছয় মাস পরে অঙ্ক বদলালে, কেউ মাঝপথে
 * যোগ দিলে, বা কারো মাস বাদ গেলে — গোনা-ভিত্তিক খাতা প্রতিবার অন্য উত্তর
 * দিত, আর কোনটা সত্যি তা বলার উপায় থাকত না।
 * ⭐ `amount_paisa` **প্রতিটা সারিতেই** — নিয়মের দিকে তাকিয়ে নেই। ওটাই
 * ইতিহাস ধরে রাখার আসল কৌশল।
 * ⚠️ সারি বসে **শুরুর মাস থেকে চলতি মাস পর্যন্ত**, আর কর্মী যোগ দেওয়ার
 * আগের কোনো মাসে নয় (`joined_on`)। নিষ্ক্রিয় হলে তার পরে আর বসে না।
 */
model SecurityDeposit {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  /// '2026-08'
  yearMonth   String   @map("year_month") @db.Char(7)
  /// ওই মাসে কত কাটা হয়েছে, পয়সায় — ⚠️ নিয়ম বদলালেও এটা বদলায় না
  amountPaisa Int      @map("amount_paisa")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  /// ⭐ একই মাসে দুবার কিস্তি বসতে পারে না — খাতা তৈরি হয় idempotent-ভাবে
  @@unique([employeeId, yearMonth])
  @@index([yearMonth])
  @@map("security_deposits")
}

/**
 * R21 — **নিষ্পত্তি: ফেরত না বাজেয়াপ্ত।**
 * ⚠️⚠️ সিদ্ধান্তটা **সিস্টেম নেয় না, মালিক নেন** (তাঁর সিদ্ধান্ত, ১৫ আগস্ট)।
 * সিস্টেম শুধু হিসাব দেয়: কত দিন আগে জানানো হয়েছে, নিয়ম কত দিনের, আর
 * কত টাকা জমেছে। ⭐ কারণ ব্যতিক্রম সবসময়ই থাকে — হাসপাতাল, পারিবারিক
 * কারণ — আর সেগুলো কোনো `if`-এ ধরা যায় না। স্বয়ংক্রিয় করলে মালিককে
 * নিয়মটা **ভাঙতে** হতো, আর ভাঙার কোনো পথ থাকত না।
 * ⭐ `notice_days` **এখানেও লেখা থাকে** — নিয়ম পরে বদলালেও এই নিষ্পত্তি
 * কোন নিয়মে হয়েছিল তা যেন পড়া যায়।
 */
model DepositSettlement {
  id              Int       @id @default(autoincrement())
  employeeId      Int       @map("employee_id")
  /// `refunded` · `forfeited`
  outcome         String
  /// নিষ্পত্তির সময় জমার অঙ্ক, পয়সায় — ⚠️ পরে খাতা বদলালেও এটা অটুট
  amountPaisa     Int       @map("amount_paisa")
  /// কবে জানিয়েছিলেন
  noticeGivenOn   DateTime? @map("notice_given_on") @db.Date
  /// শেষ কর্মদিবস
  lastWorkingDay  DateTime? @map("last_working_day") @db.Date
  /// ⭐ কত দিনের নোটিশ হয়েছিল (হিসাব করা), আর নিয়ম কত দিনের ছিল
  noticeDaysGiven Int?      @map("notice_days_given")
  noticeDaysRule  Int       @map("notice_days_rule")
  note            String?
  settledAt       DateTime  @default(now()) @map("settled_at") @db.Timestamptz(3)
  /// ⚠️ ইমেইল, `user_id` নয়
  settledBy       String    @map("settled_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  /// ⭐ একজনের একটাই নিষ্পত্তি — ফিরে এলে খাতা নতুন করে শুরু হবে, আর
  /// সেই সিদ্ধান্তটা তখনকার, আজকের নয়
  @@unique([employeeId])
  @@map("deposit_settlements")
}
