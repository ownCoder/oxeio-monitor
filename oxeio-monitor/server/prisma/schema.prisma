// ─────────────────────────────────────────────────────────────────────────────
//  oXeio Monitoring — database schema  ·  ১৯টি মডেল
//
//  সত্যের উৎস : docs/07-Technical-Spec.md § ২
//  গণনার নিয়ম  : docs/07-Technical-Spec.md § ২.১ (ক–ঙ)
//
//  এই স্কিমা যে চারটি সিদ্ধান্ত টাইপ-লেভেলেই আটকে দেয়:
//    · SegmentState-এ মাত্র তিনটি মান — BREAK/MEETING/OFF_SHIFT নেই (ADR-011d)
//    · কোনো shifts / leave_requests / time_claims টেবিল নেই (ADR-011b, 011d)
//    · প্রতিটি ingest টেবিলে clientUuid — ডুপ্লিকেট ঠেকাতে (G29)
//    · workedSec (কাঁচা) ও creditedSec (টার্গেটে যায়) আলাদা (G35)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════ enums ══════════════════════════════

/// মাত্র তিনটি স্টেট। BREAK / MEETING / OFF_SHIFT ইচ্ছাকৃতভাবে নেই — ADR-011d।
enum SegmentState {
  active
  idle
  locked
}

enum UserRole {
  owner
  manager
  employee
}

enum EmployeeStatus {
  active
  inactive
}

enum DeviceStatus {
  active
  revoked
}

enum Productivity {
  productive
  neutral
  unproductive
}

enum MatchType {
  process
  domain
  title_regex
}

enum DayType {
  worked
  no_activity
  holiday
}

/// day_rollover = মধ্যরাতে সেশন ভাগ হয়েছে (§ ২.১-ক)। shift_end নেই — শিফটই নেই।
enum SessionEndReason {
  logoff
  shutdown
  timeout
  day_rollover
}

enum AdjustmentCause {
  agent_down
  server_down
  agent_crash
  pc_replaced
  data_loss
  other
}

enum AlertSeverity {
  info
  warning
  critical
}

enum RolloutStage {
  canary
  partial
  all
  halted
}

// ══════════════════════════ reference / config ══════════════════════════

/// ⚠️ shifts টেবিলের বদলে এটি। কোনো শিফট উইন্ডো, লাঞ্চ উইন্ডো বা আসার নির্দিষ্ট সময় নেই।
model WorkPolicy {
  id                 Int     @id @default(autoincrement())
  name               String
  /// ⭐ একমাত্র টার্গেট
  monthlyTargetHours Decimal @default(208) @map("monthly_target_hours") @db.Decimal(6, 2)
  /// fallback মাত্র — আসল হিসাব ক্যালেন্ডার থেকে, § ২.১-খ
  expectedWorkdays   Int     @default(26) @map("expected_workdays")
  /// ISO দিন (শুক্র = 5)। null হলে প্রতিটি ক্যালেন্ডার দিনই কর্মদিবস।
  /// ⚠️ এটা ব্লক নয় — ছুটির দিনে কাজ করলেও ঘণ্টা পুরোপুরি গোনা হয়।
  weeklyOffDay       Int?    @map("weekly_off_day") @db.SmallInt
  /// 'HH:MM' — ক্যাপচার উইন্ডো। null হলে ২৪ ঘণ্টা ছবি ওঠে।
  screenshotFrom     String? @map("screenshot_from") @db.VarChar(5)
  screenshotTo       String? @map("screenshot_to") @db.VarChar(5)
  idleThresholdSec   Int     @default(60) @map("idle_threshold_sec")
  slotMinutes        Int     @default(5) @map("slot_minutes")
  /// Asia/Dhaka = GMT+6 (UTC+06:00), কোনো DST নেই — তাই work_date সবসময় নির্দ্বিধায় বের হয়
  timezone           String  @default("Asia/Dhaka")
  isActive           Boolean @default(true) @map("is_active")

  employees Employee[]

  @@map("work_policies")
}

model Employee {
  id             Int            @id @default(autoincrement())
  empCode        String         @unique @map("emp_code")
  fullName       String         @map("full_name")
  email          String?        @unique
  designation    String?
  department     String?
  policyId       Int?           @map("policy_id")
  /// ⭐ মাসিক বেতন — **শুধু owner দেখতে পায়** ([ADR-023](../../docs/05-Options-Decisions.md))।
  /// ঘাটতির টাকা বের করতে লাগে: (বেতন ÷ মাসিক টার্গেট ঘণ্টা) × ঘাটতি-ঘণ্টা।
  /// ⚠️ Decimal, Float নয় — টাকা কখনো binary float-এ রাখা হয় না।
  monthlySalary  Decimal?       @map("monthly_salary") @db.Decimal(12, 2)
  joinedOn       DateTime?      @map("joined_on") @db.Date
  leftOn         DateTime?      @map("left_on") @db.Date
  status         EmployeeStatus @default(active)
  /// সই করা monitoring policy — রোলআউটের বাধ্যতামূলক শর্ত
  policySignedAt DateTime?      @map("policy_signed_at") @db.Timestamptz(3)
  policyDocPath  String?        @map("policy_doc_path")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  policy          WorkPolicy?       @relation(fields: [policyId], references: [id])
  devices         Device[]
  portalUsers     User[]
  workSessions    WorkSession[]
  segments        ActivitySegment[]
  screenshots     Screenshot[]
  appUsage        AppUsage[]
  events          Event[]
  dailySummaries  DailySummary[]
  monthlySummary  MonthlySummary[]
  timeAdjustments TimeAdjustment[]
  enrollmentCodes EnrollmentCode[]
  alerts          Alert[]

  @@map("employees")
  leaves           Leave[]
}

/// ড্যাশবোর্ডে লগইন করা ইউজার — owner, manager, আর স্টাফের self-view
model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         UserRole
  /// role = employee হলে কোন স্টাফ
  employeeId   Int?      @map("employee_id")
  totpSecret   String?   @map("totp_secret")
  isActive     Boolean   @default(true) @map("is_active")
  /// প্রথম লগইনে পাসওয়ার্ড বদলাতেই হবে (G33)
  mustChangePw Boolean   @default(true) @map("must_change_pw")
  pwChangedAt  DateTime? @map("pw_changed_at") @db.Timestamptz(3)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee           Employee?        @relation(fields: [employeeId], references: [id])
  auditLogs          AuditLog[]
  settingsUpdated    Setting[]
  alertsAcknowledged Alert[]
  enrollmentCodes    EnrollmentCode[]
  adjustmentsCreated TimeAdjustment[] @relation("AdjustmentCreatedBy")
  adjustmentsRevoked TimeAdjustment[] @relation("AdjustmentRevokedBy")

  @@map("users")
}

model Device {
  id              Int          @id @default(autoincrement())
  hostname        String
  windowsUsername String       @map("windows_username")
  employeeId      Int?         @map("employee_id")
  /// হার্ডওয়্যার-ভিত্তিক স্থায়ী আইডি
  /// ⚠️⚠️ **আর UNIQUE নয়** — একই PC-তে দুজন স্টাফ আলাদা Windows
  /// অ্যাকাউন্টে কাজ করলে দুটো সারি লাগে, অথচ `MachineGuid` মেশিনের,
  /// ব্যবহারকারীর নয়। ডিভাইসের পরিচয় এখন `@@unique([hostname,
  /// windowsUsername])` (নিচে) — মেশিন **ও** যিনি বসেছেন, দুটো মিলে।
  /// ⭐ মানটা রাখা আছে: H04-এর rollout bucket এটা দিয়েই গোনা হয়, আর
  /// এজেন্ট নিজের `device.dat` এর সাথে মিলিয়ে ক্লোন ধরে।
  machineGuid     String       @map("machine_guid")
  osVersion       String?      @map("os_version")
  agentVersion    String?      @map("agent_version")
  /// device token-এর sha256 — plaintext কখনো জমা হয় না
  tokenHash       String       @map("token_hash")
  monitors        Int          @default(1)
  status          DeviceStatus @default(active)
  lastSeenAt      DateTime?    @map("last_seen_at") @db.Timestamptz(3)
  /// ⭐ শেষ heartbeat-এ এজেন্ট কী বলেছিল। এটা ছাড়া Live Board শেষ
  /// activity_segments সারি থেকে **অনুমান** করত, আর এজেন্ট সেগমেন্ট
  /// ব্যাচে পাঠায় বলে বোর্ডের স্ট্যাটাস কয়েক মিনিট পুরোনো দেখাত।
  lastState       SegmentState? @map("last_state")
  lastStateAt     DateTime?    @map("last_state_at") @db.Timestamptz(3)
  lastDriftSec    Int          @default(0) @map("last_drift_sec")
  maxDriftSec     Int          @default(0) @map("max_drift_sec")
  enrolledAt      DateTime     @default(now()) @map("enrolled_at") @db.Timestamptz(3)

  employee        Employee?         @relation(fields: [employeeId], references: [id])
  workSessions    WorkSession[]
  segments        ActivitySegment[]
  screenshots     Screenshot[]
  appUsage        AppUsage[]
  events          Event[]
  alerts          Alert[]
  enrollmentCodes EnrollmentCode[]

  @@unique([hostname, windowsUsername])
  @@map("devices")
}

/// এজেন্ট রেজিস্ট্রেশনের একবার-ব্যবহার্য কোড (G34)
model EnrollmentCode {
  id             Int       @id @default(autoincrement())
  /// কোড কখনো plaintext-এ জমা হয় না — একবারই দেখানো হয়
  codeHash       String    @unique @map("code_hash")
  employeeId     Int       @map("employee_id")
  createdById    Int       @map("created_by")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  usedByDeviceId Int?      @map("used_by_device_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee     Employee @relation(fields: [employeeId], references: [id])
  createdBy    User     @relation(fields: [createdById], references: [id])
  usedByDevice Device?  @relation(fields: [usedByDeviceId], references: [id])

  @@map("enrollment_codes")
}

// ══════════════════════════ core tracking ══════════════════════════

/// PC-তে লগইন থেকে লগআউট পর্যন্ত একটা সেশন। মধ্যরাতে ভাগ হয় (§ ২.১-ক)।
model WorkSession {
  id         BigInt            @id @default(autoincrement())
  employeeId Int               @map("employee_id")
  deviceId   Int               @map("device_id")
  /// Asia/Dhaka অনুযায়ী
  workDate   DateTime          @map("work_date") @db.Date
  startedAt  DateTime          @map("started_at") @db.Timestamptz(3)
  endedAt    DateTime?         @map("ended_at") @db.Timestamptz(3)
  endReason  SessionEndReason? @map("end_reason")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee          @relation(fields: [employeeId], references: [id])
  device   Device            @relation(fields: [deviceId], references: [id])
  segments ActivitySegment[]

  @@index([employeeId, workDate])
  @@map("work_sessions")
}

/// ⭐ মূল টাইম ট্র্যাকিং টেবিল।
/// ⚠️ কোনো সেগমেন্ট দুই workDate জুড়ে থাকতে পারবে না — মধ্যরাতে ভাগ হয় (§ ২.১-ক)।
/// ⚠️ এই টেবিল কখনো এডিট বা ডিলিট হয় না — সংশোধন যায় TimeAdjustment-এ (§ ২.১-ঙ)।
model ActivitySegment {
  id           BigInt       @id @default(autoincrement())
  sessionId    BigInt       @map("session_id")
  employeeId   Int          @map("employee_id")
  /// একই স্টাফের দুই ডিভাইসে overlap ধরার জন্য (§ ২.১-গ)
  deviceId     Int          @map("device_id")
  /// এজেন্টের দেওয়া আইডি — রিট্রাইয়ে ডুপ্লিকেট ঠেকায় (§ ২.১-ঘ)
  clientUuid   String       @unique @map("client_uuid") @db.Uuid
  /// startedAt-এর Asia/Dhaka তারিখ
  workDate     DateTime     @map("work_date") @db.Date
  state        SegmentState
  startedAt    DateTime     @map("started_at") @db.Timestamptz(3)
  endedAt      DateTime     @map("ended_at") @db.Timestamptz(3)
  /// monotonic clock থেকে — PC-র ঘড়ি বদলালেও অটুট
  durationSec  Int          @map("duration_sec")
  /// 0–100, ওই খণ্ডে কতটা অ্যাক্টিভ ছিল। কীলগিং নয়।
  inputScore   Int?         @map("input_score") @db.SmallInt
  /// = (state == active); ingest-এ সেট হয়
  countsAsWork Boolean      @default(false) @map("counts_as_work")

  session  WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee Employee    @relation(fields: [employeeId], references: [id])
  device   Device      @relation(fields: [deviceId], references: [id])

  @@index([employeeId, workDate, state])
  @@index([startedAt])
  @@map("activity_segments")
}

model Screenshot {
  id           BigInt    @id @default(autoincrement())
  employeeId   Int       @map("employee_id")
  deviceId     Int       @map("device_id")
  clientUuid   String    @unique @map("client_uuid") @db.Uuid
  workDate     DateTime  @map("work_date") @db.Date
  /// ৫ মিনিটের স্লটের শুরু
  slotStart    DateTime  @map("slot_start") @db.Timestamptz(3)
  /// আসল র‍্যান্ডম সময় — স্লটের ভেতরে কখন ছবি উঠল
  capturedAt   DateTime  @map("captured_at") @db.Timestamptz(3)
  monitorIndex Int       @default(0) @map("monitor_index") @db.SmallInt
  filePath     String    @map("file_path")
  thumbPath    String?   @map("thumb_path")
  width        Int?
  height       Int?
  sizeBytes    Int?      @map("size_bytes")
  activeApp    String?   @map("active_app")
  activeTitle  String?   @map("active_title")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  /// retention job এখানে মার্ক করে, তারপর ফাইল মোছে
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])
  device   Device   @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, slotStart, monitorIndex])
  @@index([employeeId, workDate])
  @@map("screenshots")
}

model AppUsage {
  id          BigInt   @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  deviceId    Int      @map("device_id")
  clientUuid  String   @unique @map("client_uuid") @db.Uuid
  workDate    DateTime @map("work_date") @db.Date
  startedAt   DateTime @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime @map("ended_at") @db.Timestamptz(3)
  durationSec Int      @map("duration_sec")
  processName String   @map("process_name")
  appName     String?  @map("app_name")
  windowTitle String?  @map("window_title")
  /// ⚠️ শুধু ডোমেইন — ফুল URL কখনো নয় (ADR-013)
  domain      String?
  categoryId  Int?     @map("category_id")
  isBrowser   Boolean  @default(false) @map("is_browser")

  employee Employee     @relation(fields: [employeeId], references: [id])
  device   Device       @relation(fields: [deviceId], references: [id])
  category AppCategory? @relation(fields: [categoryId], references: [id])

  @@index([employeeId, workDate])
  @@index([domain])
  @@map("app_usage")
}

model AppCategory {
  id          Int          @id @default(autoincrement())
  matchType   MatchType    @map("match_type")
  /// 'code.exe' | 'facebook.com' | regex
  pattern     String
  displayName String       @map("display_name")
  category    Productivity
  priority    Int          @default(100)

  appUsage AppUsage[]

  @@map("app_categories")
}

// ══════════════════════════ events ও audit ══════════════════════════

model Event {
  id         BigInt   @id @default(autoincrement())
  deviceId   Int?     @map("device_id")
  employeeId Int?     @map("employee_id")
  clientUuid String   @unique @map("client_uuid") @db.Uuid
  /// agent_start | agent_stop | logon | logoff | lock | unlock | sleep | resume
  /// agent_crash | clock_drift | screenshot_skipped | day_rollover | segment_split
  type       String
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  meta       Json?
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  device   Device?   @relation(fields: [deviceId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([employeeId, occurredAt])
  @@map("events")
}

/// ⚠️ time_claims টেবিল নেই — স্টাফের চাওয়ার কোনো ব্যবস্থা নেই (ADR-011d)।
/// এটি আলাদা জিনিস: সিস্টেমের নিজের দোষে হারানো ঘণ্টা owner ফেরত দেয় (ADR-011e, § ২.১-ঙ)।
model TimeAdjustment {
  id              BigInt          @id @default(autoincrement())
  employeeId      Int             @map("employee_id")
  workDate        DateTime        @map("work_date") @db.Date
  /// + = ঘণ্টা ফেরত · − = কেটে নেওয়া
  deltaSec        Int             @map("delta_sec")
  cause           AdjustmentCause
  /// ⭐ বাধ্যতামূলক — খালি রাখা যাবে না
  reason          String
  evidenceAlertId BigInt?         @map("evidence_alert_id")
  /// মাপা downtime-এর চেয়ে বেশি দেওয়া হয়েছে? রিপোর্টে আলাদা দেখায়
  beyondEvidence  Boolean         @default(false) @map("beyond_evidence")
  /// শুধু owner
  createdById     Int             @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  /// ডিলিট নেই — শুধু revoke, রেকর্ড থেকে যায়
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz(3)
  revokedById     Int?            @map("revoked_by")
  revokeReason    String?         @map("revoke_reason")

  employee      Employee @relation(fields: [employeeId], references: [id])
  createdBy     User     @relation("AdjustmentCreatedBy", fields: [createdById], references: [id])
  revokedBy     User?    @relation("AdjustmentRevokedBy", fields: [revokedById], references: [id])
  evidenceAlert Alert?   @relation(fields: [evidenceAlertId], references: [id])

  @@index([employeeId, workDate])
  @@map("time_adjustments")
}

/// কোন অ্যাডমিন কার স্ক্রিনশট কখন দেখল — সেটাও রেকর্ড থাকে
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     Int?     @map("user_id")
  /// view_screenshot | export_report | change_setting | reset_password
  /// create_enrollment_code | revoke_device | upload_policy_doc
  /// time_adjustment | time_adjustment_revoke
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  ipAddress  String?  @map("ip_address") @db.Inet
  meta       Json?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, occurredAt])
  @@map("audit_log")
}

model Setting {
  key         String   @id
  value       Json
  updatedById Int?     @map("updated_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("settings")
}

// ══════════════════ ক্যালেন্ডার ══════════════════
// ⚠️ leave_types / leave_requests / leave_balances নেই — ইচ্ছাকৃত (ADR-011d)।

/// দুই কাজে লাগে: হিটম্যাপে দিন চিহ্নিত করা, আর pace-এর কর্মদিবস গোনা (§ ২.১-খ)।
/// ⚠️ ব্লক নয় — ছুটির দিনে কেউ কাজ করলে সেই ঘণ্টাও পুরোপুরি গোনা হবে।
model Holiday {
  id          Int      @id @default(autoincrement())
  holidayDate DateTime @unique @map("holiday_date") @db.Date
  name        String
  type        String   @default("public")

  @@map("holidays")
}

// ══════════════════ অ্যালার্ট ও এজেন্ট ভার্সন ══════════════════

model Alert {
  id               BigInt        @id @default(autoincrement())
  /// agent_down | agent_killed | disk_warning | disk_critical | backup_failed
  /// clock_drift | no_activity_today | device_overlap
  type             String
  severity         AlertSeverity
  employeeId       Int?          @map("employee_id")
  deviceId         Int?          @map("device_id")
  title            String
  detail           String?
  meta             Json?
  channelsSent     String[]      @map("channels_sent")
  acknowledgedById Int?          @map("acknowledged_by")
  acknowledgedAt   DateTime?     @map("acknowledged_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  employee       Employee?        @relation(fields: [employeeId], references: [id])
  device         Device?          @relation(fields: [deviceId], references: [id])
  acknowledgedBy User?            @relation(fields: [acknowledgedById], references: [id])
  adjustments    TimeAdjustment[]

  @@index([createdAt])
  @@map("alerts")
}

model AgentVersion {
  version      String       @id
  msiPath      String       @map("msi_path")
  sha256       String
  releaseNotes String?      @map("release_notes")
  rolloutStage RolloutStage @default(canary) @map("rollout_stage")
  isMandatory  Boolean      @default(false) @map("is_mandatory")
  releasedAt   DateTime     @default(now()) @map("released_at") @db.Timestamptz(3)

  @@map("agent_versions")
}

// ══════════════════ rollup — রিপোর্ট দ্রুত করার জন্য ══════════════════
// প্রতি ১৫ মিনিটে ও দিন-ক্লোজে (০০:১৫) রিফ্রেশ হয়

/// ⚠️ target / shortfall / overtime / late / attendance এখানে নেই —
///    দৈনিক কোনো টার্গেটই নেই। সব টার্গেট-হিসাব MonthlySummary-তে।
model DailySummary {
  employeeId      Int       @map("employee_id")
  workDate        DateTime  @map("work_date") @db.Date
  firstActivityAt DateTime? @map("first_activity_at") @db.Timestamptz(3)
  lastActivityAt  DateTime? @map("last_activity_at") @db.Timestamptz(3)
  activeSec       Int       @default(0) @map("active_sec")
  /// লাঞ্চ / চা / বিরতি সব এখানেই — আলাদা করে ট্র্যাক হয় না (ADR-011)
  idleSec         Int       @default(0) @map("idle_sec")
  /// ⭐ প্রকৃত ACTIVE-এর UNION (§ ২.১-গ) — এই সংখ্যা কখনো এডিট হয় না
  workedSec       Int       @default(0) @map("worked_sec")
  /// ⭐ owner-এর সংশোধন, ± (§ ২.১-ঙ)
  adjustmentSec   Int       @default(0) @map("adjustment_sec")
  /// ⭐ worked + adjustment → মাসিক টার্গেটে এটাই যায়
  creditedSec     Int       @default(0) @map("credited_sec")
  /// দিনের প্রথম ও শেষ active ঘণ্টা (0–23) — তথ্য মাত্র, বিচারের মাপকাঠি নয়
  earliestHour    Int?      @map("earliest_hour") @db.SmallInt
  latestHour      Int?      @map("latest_hour") @db.SmallInt
  productiveSec   Int       @default(0) @map("productive_sec")
  unproductiveSec Int       @default(0) @map("unproductive_sec")
  productivityPct Decimal?  @map("productivity_pct") @db.Decimal(5, 2)
  screenshotCount Int       @default(0) @map("screenshot_count")
  dayType         DayType?  @map("day_type")
  computedAt      DateTime  @default(now()) @map("computed_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([employeeId, workDate])
  @@map("daily_summary")
}

/// ⭐ প্রধান রিপোর্টিং টেবিল — একমাত্র মাপকাঠি এখানেই
model MonthlySummary {
  employeeId       Int       @map("employee_id")
  /// '2026-08'
  yearMonth        String    @map("year_month") @db.Char(7)
  /// কাঁচা হিসাব
  workedSec        Int       @default(0) @map("worked_sec")
  adjustmentSec    Int       @default(0) @map("adjustment_sec")
  /// ⭐ worked + adjustment — টার্গেটের সাথে এটাই মেলানো হয়
  creditedSec      Int       @default(0) @map("credited_sec")
  /// ২০৮ ঘণ্টা
  targetSec        Int       @default(748800) @map("target_sec")
  /// আজ পর্যন্ত যত হওয়ার কথা (§ ২.১-খ)
  expectedSec      Int       @default(0) @map("expected_sec")
  /// credited − expected · ধনাত্মক = এগিয়ে
  paceSec          Int       @default(0) @map("pace_sec")
  /// ⭐ **তার নিজের** কর্মদিবস (d) — joined_on … left_on-এর ভেতরে যতগুলো পড়ে।
  /// ⚠️ G37-এর আগে এটা ছিল "ওই মাসের মোট কর্মদিবস"; মানেটা বদলেছে (ADR-025)।
  expectedWorkdays Int       @map("expected_workdays")
  /// ⭐ ওই মাসের মোট কর্মদিবস (D) — বেতনের ভগ্নাংশ d÷D-এর হর।
  /// ⚠️ আলাদা করে রাখা হয়, পে-রোলের সময় আবার গোনা হয় না: ছুটির তালিকা
  /// বদলালে d আর D দুই আলাদা সময়ের হিসাব হয়ে যেত, আর ভগ্নাংশটা ভুল হতো।
  monthWorkdays    Int       @default(0) @map("month_workdays")
  /// ⭐ R2 — অনুমোদিত ছুটির কর্মদিবস। টার্গেট কমায়, `d ÷ D` ছোঁয় না।
  leaveWorkdays    Int       @default(0) @map("leave_workdays")
  /// ⭐ আজ পর্যন্ত কত কর্মদিবস গেছে
  workdaysElapsed  Int       @default(0) @map("workdays_elapsed")
  daysWithWork     Int       @default(0) @map("days_with_work")
  avgDailySec      Int       @default(0) @map("avg_daily_sec")
  overtimeSec      Int       @default(0) @map("overtime_sec")
  shortfallSec     Int       @default(0) @map("shortfall_sec")
  targetMet        Boolean   @default(false) @map("target_met")
  targetMetAt      DateTime? @map("target_met_at") @db.Timestamptz(3)
  computedAt       DateTime  @default(now()) @map("computed_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([employeeId, yearMonth])
  @@map("monthly_summary")
}

/**
 * R1 — **মাস বন্ধ করা।**
 *
 * ⚠️⚠️ যে সমস্যাটা এটা সারায়: `monthly_summary`-র প্রতিটা সংখ্যা
 * `refreshMonth()` **প্রতিবার নতুন করে গোনে**, আর গোনার সময় ওই মুহূর্তের
 * `holidays` টেবিল পড়ে। তাই ছুটির একটা তারিখ নড়লে — বা পুরোনো মাসের কোনো
 * সময়-সংশোধন অনুমোদন হলে — **গত মাসের `target_sec` · `expected_sec` ·
 * `expected_workdays` (d) · `month_workdays` (D) চারটেই পিছন ফিরে বদলায়**।
 * পে-রোল ওই সারি থেকেই d ও D পড়ে, অর্থাৎ বেতন দিয়ে দেওয়ার পরেও হিসাব
 * নড়তে পারত, আর কোন সংখ্যায় বেতন হয়েছিল তা প্রমাণ করার উপায় থাকত না।
 *
 * ⭐⭐ **সারি এখানে, সংখ্যা নয়।** রোডম্যাপে "স্ন্যাপশট টেবিল" লেখা ছিল,
 * কিন্তু তাতে একই মাসের **দুটো** সংখ্যা তৈরি হতো — লাইভ আর জমাট — আর
 * "দুই পর্দায় দুই সংখ্যা" এই রিপোর সবচেয়ে বড় পাপ (G88)। বদলে সংখ্যাগুলো
 * `monthly_summary`-তেই **জায়গামতো জমাট** হয়: মাস বন্ধ থাকলে
 * `refreshMonth()` ওই মাস আর ছোঁয় না, আর সংশোধন ঢুকতে চাইলে ৪০৯।
 * এই টেবিলটা কেবল **কে কখন বন্ধ করল** তার রেকর্ড।
 *
 * ⭐ চাবি শুধু `year_month` — মাস সবার জন্য একসাথে বন্ধ হয়, একজন-একজন করে
 * নয়। কর্মীপ্রতি বন্ধ করা গেলে "আগস্ট বন্ধ কি না" প্রশ্নের উত্তর হতো
 * "কার জন্য?" — আর পে-রোল চলে পুরো মাস ধরে।
 */
model MonthClosure {
  /// '2026-08'
  yearMonth String   @id @map("year_month") @db.Char(7)
  closedAt  DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)
  /// ⚠️ ইমেইল, `user_id` নয় — ইউজার মুছে গেলেও "কে বন্ধ করেছিল" টিকে থাকা দরকার
  closedBy  String   @map("closed_by")
  /// কেন, বা কিসের ভিত্তিতে — ঐচ্ছিক
  note      String?

  @@map("month_closures")
}

/**
 * R2 — **ছুটির খাতা।**
 *
 * ⚠️⚠️ **কোনো আবেদন-অনুমোদন প্রবাহ নয়** — "স্টাফের চাপার মতো কোনো বোতাম
 * নেই" এই সিস্টেমের ঘোষিত নিয়ম। স্টাফ মুখে বলেন, owner লিখে রাখেন।
 * তাই এখানে `status`/`approvedBy` জাতীয় কোনো ঘর নেই, আর থাকা উচিতও নয়।
 *
 * ⭐⭐ **এক সারি = এক দিন**, তারিখের সীমা নয়। পর্দা সীমা নেয় ("৩–৭ আগস্ট")
 * আর সেটাকে দিনে ভেঙে বসায়। কারণ গোনা, বাদ দেওয়া আর একটা দিন মুছে ফেলা —
 * তিনটেই তখন তুচ্ছ; সীমা রাখলে প্রতিটা হিসাবে ওভারল্যাপ ও আংশিক-ছেদ
 * সামলাতে হতো, আর ওখানেই বাগ জন্মাত।
 *
 * ⭐⭐ **ছুটি ঘণ্টার টার্গেট কমায়, বেতন নয়** — অর্থাৎ **সবেতন**।
 * `monthly_summary.expected_workdays` (d) অপরিবর্তিত থাকে, তাই পে-রোলের
 * `d ÷ D` ভগ্নাংশও অটুট। কমে কেবল `target_sec` ও `expected_sec`।
 * ⚠️ উল্টোটা (d কমানো) মানে ছুটি নিলেই নীরবে বেতন কাটা — সেটা মালিকের
 * সজ্ঞান সিদ্ধান্ত ছাড়া করা যায় না।
 *
 * ⚠️ ছুটির দিনে কেউ কাজ করলে ঘণ্টা **গোনা হবেই** — ছুটি মানে টার্গেট মাফ,
 * কাজ নিষেধ নয় (§ ২.১-খ-এর নিয়ম ছুটিতেও এক)।
 */
model Leave {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  /// ঢাকার কর্মদিবস — `holidays.holiday_date`-এর মতোই UTC-মধ্যরাত
  leaveDate  DateTime @map("leave_date") @db.Date
  /// `casual` · `sick` · `annual` — **তিনটেই সবেতন**
  ///
  /// ⚠️⚠️ `unpaid` ইচ্ছাকৃতভাবে **নেই**। বিনা-বেতনের ছুটি d (`d ÷ D`-র লব)
  /// কমাত, অথচ এখানকার সব কোড ছুটিকে সবেতন ধরে। নামটা রেখে দিলে খাতায়
  /// `unpaid` লেখা থাকত আর বেতন কাটত না — সংখ্যাটা এমন কিছু দাবি করত যা
  /// সে জানে না। দরকার হলে সেটা পে-রোলের আলাদা সিদ্ধান্ত।
  type       String   @default("casual")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// ⚠️ ইমেইল, `user_id` নয় — ইউজার মুছে গেলেও "কে লিখেছিল" টিকে থাকা দরকার
  createdBy  String   @map("created_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  /// ⭐ একই দিনে দুবার ছুটি লেখা যায় না — নইলে গোনায় দুবার বাদ যেত
  @@unique([employeeId, leaveDate])
  @@index([leaveDate])
  @@map("leaves")
}
