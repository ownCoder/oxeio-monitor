# ── Copy this file to .env and fill in real values ──────────────
# .env is gitignored. Never commit real secrets.
#
# ⚠️ Everything the server reads is listed here, including the parts you can
#    leave empty. That is deliberate: a missing SMTP host does not fail — the
#    email channel just stays silent, and alerts pile up in the database that
#    nobody ever receives. An empty line you can see beats a setting you never
#    knew existed.

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=oxeio
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=oxeio

# Used by the API when running OUTSIDE docker (npm run start:dev).
# Inside docker the host is `postgres`, and compose sets it for you.
DATABASE_URL=postgresql://oxeio:change-me-to-a-long-random-string@localhost:5432/oxeio?schema=public

# ── Auth ────────────────────────────────────────────────────────────────────
# generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters — the server refuses to start otherwise.
JWT_SECRET=change-me-to-a-long-random-string

# Optional. Signed screenshot links use their own key derived from this;
# leave empty and JWT_SECRET is used (still a separate derived key).
SCREENSHOT_URL_SECRET=

# ── Login lockout (I11) ─────────────────────────────────────────────────────
# How many wrong passwords before the account+IP is locked, and for how long.
#
# Defaults are deliberately forgiving (10 tries, 2 minutes). The old hardcoded
# 5 tries / 15 minutes turned a few typos into "Try again in 13 minutes",
# which read as "the password reset did not work" — see docs/09 § ৩ড়.
#
# Set LOGIN_LOCK_MINUTES=0 to switch the lockout OFF completely. The server
# logs a warning at startup when it is off, so nobody assumes it is on.
LOGIN_MAX_FAILS=10
LOGIN_LOCK_MINUTES=2
# Per-IP ceiling, whatever the email (G116). The pair counter above only
# catches someone guessing ONE person's password; an attacker trying a
# thousand different emails from one IP used to hit no limit at all.
# Defaults to 5x LOGIN_MAX_FAILS. Kept deliberately high: the whole
# office shares one IP, so a password-reset day can produce 20-30 typos.
LOGIN_IP_MAX_FAILS=50

# ── Storage ─────────────────────────────────────────────────────────────────
# Where screenshots are written (host path, mounted into the API container)
STORAGE_HOST_PATH=./.data/storage

# ── Dashboard ───────────────────────────────────────────────────────────────
# Port the dashboard is served on (the `web` service).
WEB_PORT=8080

# Only needed for clients on a DIFFERENT origin. The `web` service serves the
# dashboard and the API from one origin, so this does not apply to it.
CORS_ORIGIN=http://localhost:5173

# ── First owner account, created by the seed step ───────────────────────────
SEED_OWNER_EMAIL=owner@oxeio.local
SEED_OWNER_PASSWORD=change-me-on-first-login
SEED_OWNER_NAME=oXeio Owner

# ── Email (G05 · G07 · F07) ─────────────────────────────────────────────────
# ⚠️ Leave SMTP_HOST empty and the email channel is OFF. Alerts are still
#    raised and stored — they simply never reach anyone.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=oXeio Monitoring <alerts@example.com>

# Where alerts go. Empty = every active owner's email address.
ALERT_EMAIL_TO=
# Where the evening digest goes. Empty = every active owner.
DIGEST_EMAIL_TO=
# Shown in report headers and email subjects
ORG_NAME=oXeio Monitoring

# ── Telegram alerts (G08) ───────────────────────────────────────────────────
# Both empty = channel off, silently and on purpose.
TELEGRAM_BOT_TOKEN=
# ⚠️⚠️ The OWNER's chat, never a staff group. The weekly summary below names
#    who is behind; in a team group that is weekly public shaming, and a sent
#    Telegram message cannot be taken back.
# ⭐ A private chat id is a plain positive number (e.g. 123456789). Group,
#    supergroup and channel ids are negative (-100…). If this is not a plain
#    positive number, the WEEKLY SUMMARY is not sent and the log says so —
#    see WEEKLY_DIGEST_ALLOW_GROUP below. Alerts still go either way: they
#    carry only a hostname and an alert type, nobody's name.
TELEGRAM_CHAT_ID=

# ── Weekly summary on Telegram (R3) ─────────────────────────────────────────
# Sent to TELEGRAM_CHAT_ID above — hours per person, who is on track, who is
# behind, and the team total for the 7 days ending that day.
# Day: 1=Mon … 5=Fri … 7=Sun (same numbering as weekly_off_day). Hour: 0–23,
# Dhaka time. Anything else is ignored, logged as an error, and the default
# is used — the summary never silently goes out at the wrong time.
#
# On a fresh install the first summary covers days from before tracking even
# started. Those days are left out of the expected hours (and the message says
# from which day it counted), so nobody is named as "behind" for a week the
# server never saw. Expect the first one or two summaries to look sparse.
WEEKLY_DIGEST_DAY=5
WEEKLY_DIGEST_HOUR=18

# ⚠️⚠️ Leave this empty unless you truly mean it.
# The guard: if TELEGRAM_CHAT_ID is not a private chat id (i.e. not a plain
# positive number), the weekly summary is NOT sent. The summary names who is
# behind, so in a staff group that is weekly public shaming — and Telegram
# messages cannot be unsent. Nothing is lost when it is blocked: the full
# text is written to the server log, so you can still read that week.
# Set it to `true` to send to that chat anyway — a deliberate choice, not a
# silent one. Any other value (including empty) keeps the guard on.
WEEKLY_DIGEST_ALLOW_GROUP=

# ── Backup (K02 · K03 · G39) ────────────────────────────────────────────────
# ⚠️ No passphrase = NO BACKUPS AT ALL. This is deliberate: an unencrypted
#    dump of payroll hours and screenshots sitting on disk is worse than no
#    dump. The server logs an error at boot and raises a G04 alert daily.
BACKUP_PASSPHRASE=
# Where dumps are written inside the API container
BACKUP_DIR=
# How many days of dumps to keep
BACKUP_KEEP_DAYS=30
# Second copy — an external drive or another machine. Empty = no off-site copy.
BACKUP_COPY_TO=

# How pg_dump is reached. Pick ONE:
#   a) postgresql-client installed on the host → set BACKUP_PG_DUMP
#   b) dump from inside the postgres container → set BACKUP_DOCKER_CONTAINER
#      ⚠️ (b) needs the docker socket mounted into the API container, which is
#         effectively root on the host. See docker-compose.yml.
BACKUP_PG_DUMP=
BACKUP_DOCKER_CONTAINER=
BACKUP_DOCKER_BIN=
BACKUP_DOCKER_DB_HOST=

# ── TLS (I01) ───────────────────────────────────────────────────────────────
# ⚠️ Set BOTH or NEITHER — with only one the server refuses to start, on
#    purpose. Silently falling back to HTTP would put device tokens on the
#    LAN in plaintext for months while everything looked fine.
# Create the certificate with deploy/make-cert.ps1 (deploy/README § 6).
# ⚠️ Turning this on also needs: ports → "443:3000", the certs volume, and
#    the transport block in web/Caddyfile.
TLS_CERT=
TLS_KEY=

# ── VPS-এ চালালে (ADR-026) ───────────────────────────────────────────────
# ⭐ ডোমেইনটা এক জায়গায় — Caddy এখান থেকেই সাইটের ঠিকানা নেয়, আর
#    Let's Encrypt থেকে সার্ট নিয়ে নিজেই নবায়ন করে।
# ⚠️ আগে DNS বসান: A রেকর্ড → VPS-এর IP। না বসালে সার্ট ইস্যুই হবে না।
# PUBLIC_HOST=monitor.oxeio.com

# ⚠️ দুটো compose ফাইল একসাথে লাগে। এটা লিখে রাখলে খালি
#    `docker compose up -d` দিলেই দুটোই ধরা হয় — একটা ভুলে যাওয়ার
#    ঝুঁকি থাকে না।
# COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml
