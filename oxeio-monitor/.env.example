# ── Copy this file to .env and fill in real values ──────────────
# .env is gitignored. Never commit real secrets.

# Database
POSTGRES_USER=oxeio
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=oxeio

# Used by the API when running OUTSIDE docker (npm run start:dev).
# Inside docker the host is `postgres`, and compose sets it for you.
DATABASE_URL=postgresql://oxeio:change-me-to-a-long-random-string@localhost:5432/oxeio?schema=public

# Auth — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where screenshots are written (host path, mounted into the API container)
STORAGE_HOST_PATH=./.data/storage

# Dashboard origin allowed to call the API
CORS_ORIGIN=http://localhost:5173

# First owner account, created by `npm run seed`
SEED_OWNER_EMAIL=owner@oxeio.local
SEED_OWNER_PASSWORD=change-me-on-first-login
SEED_OWNER_NAME=oXeio Owner
